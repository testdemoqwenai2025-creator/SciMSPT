<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>About — SciMSPT Neural Research Intelligence</title>
  <meta name="description" content="About SciMSPT: Our mission to transform scientific discovery into strategic opportunity through neural intelligence and molecular computing.">
  
  <!-- Fonts -->
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;700;900&family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500;600&family=Orbitron:wght@400;700;900&display=swap" rel="stylesheet">
  <link href="https://fonts.googleapis.com/icon?family=Material+Icons+Round" rel="stylesheet">
  
  <style>
    :root {
      --bg-deep: #030810;
      --bg-primary: #0a1628;
      --bg-secondary: #0d1f35;
      --bg-tertiary: #122a45;
      --bg-glass: rgba(10, 22, 40, 0.85);
      --bg-glass-light: rgba(255, 255, 255, 0.03);
      
      --accent-primary: #00E5FF;
      --accent-secondary: #4da8da;
      --accent-tertiary: #a78bfa;
      --accent-pink: #f472b6;
      --accent-green: #10b981;
      --accent-gold: #f59e0b;
      
      --text-primary: #e8f4fc;
      --text-secondary: #94a3b8;
      --text-muted: #64748b;
      
      --border-subtle: rgba(0, 229, 255, 0.15);
      
      --font-heading: 'Playfair Display', Georgia, serif;
      --font-body: 'Inter', -apple-system, sans-serif;
      --font-mono: 'JetBrains Mono', monospace;
      --font-tech: 'Orbitron', sans-serif;
      
      --nav-height: 80px;
      --sidebar-width: 100px;
    }
    
    [data-theme="light"] {
      --bg-deep: #f0f4f8;
      --bg-primary: #ffffff;
      --bg-secondary: #f8fafc;
      --bg-tertiary: #e2e8f0;
      --bg-glass: rgba(255, 255, 255, 0.92);
      --bg-glass-light: rgba(0, 0, 0, 0.02);
      --text-primary: #0f172a;
      --text-secondary: #475569;
      --text-muted: #94a3b8;
      --border-subtle: rgba(77, 168, 218, 0.25);
    }
    
    * { margin: 0; padding: 0; box-sizing: border-box; }
    html { scroll-behavior: smooth; }
    
    body {
      font-family: var(--font-body);
      background: var(--bg-deep);
      color: var(--text-primary);
      line-height: 1.6;
      overflow-x: hidden;
      min-height: 100vh;
    }
    
    /* Molecular Sidebars */
    .molecular-sidebar {
      position: fixed;
      top: 0;
      width: var(--sidebar-width);
      height: 100vh;
      z-index: 5;
      pointer-events: none;
      overflow: hidden;
    }
    
    .molecular-sidebar.left {
      left: 0;
      background: linear-gradient(90deg, rgba(0, 229, 255, 0.08) 0%, transparent 100%);
      border-right: 1px solid var(--border-subtle);
    }
    
    .molecular-sidebar.right {
      right: 0;
      background: linear-gradient(-90deg, rgba(167, 139, 250, 0.08) 0%, transparent 100%);
      border-left: 1px solid var(--border-subtle);
    }
    
    .dna-helix {
      position: absolute;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      width: 60px;
      height: 80vh;
    }
    
    .nucleotide {
      position: absolute;
      width: 12px;
      height: 12px;
      border-radius: 50%;
      animation: nucleotidePulse 3s ease-in-out infinite;
    }
    
    .nucleotide.adenine { background: var(--accent-primary); box-shadow: 0 0 10px var(--accent-primary); }
    .nucleotide.thymine { background: var(--accent-pink); box-shadow: 0 0 10px var(--accent-pink); }
    .nucleotide.guanine { background: var(--accent-tertiary); box-shadow: 0 0 10px var(--accent-tertiary); }
    .nucleotide.cytosine { background: var(--accent-green); box-shadow: 0 0 10px var(--accent-green); }
    
    @keyframes nucleotidePulse {
      0%, 100% { opacity: 0.6; transform: scale(1); }
      50% { opacity: 1; transform: scale(1.2); }
    }
    
    .backbone-line {
      position: absolute;
      width: 2px;
      height: 100%;
      left: 50%;
      background: linear-gradient(to bottom, transparent, var(--accent-primary) 20%, var(--accent-tertiary) 50%, var(--accent-pink) 80%, transparent);
      opacity: 0.3;
    }
    
    .protein-chain { position: absolute; width: 40px; height: 200px; top: 20%; }
    
    .amino-acid {
      position: absolute;
      width: 8px;
      height: 8px;
      border-radius: 2px;
      background: var(--accent-gold);
      opacity: 0.7;
      animation: aminoFloat 4s ease-in-out infinite;
    }
    
    @keyframes aminoFloat {
      0%, 100% { transform: translateX(0) rotate(0deg); }
      50% { transform: translateX(10px) rotate(180deg); }
    }
    
    .molecular-grid {
      position: absolute;
      top: 0; left: 0;
      width: 100%; height: 100%;
      background-image: 
        radial-gradient(circle at 20% 30%, rgba(0, 229, 255, 0.05) 1px, transparent 1px),
        radial-gradient(circle at 70% 60%, rgba(167, 139, 250, 0.05) 1px, transparent 1px);
      background-size: 30px 30px, 50px 50px;
      animation: gridShift 20s linear infinite;
    }
    
    @keyframes gridShift {
      0% { transform: translateY(0); }
      100% { transform: translateY(30px); }
    }
    
    .floating-molecule {
      position: absolute;
      border: 1px solid var(--border-subtle);
      border-radius: 50%;
      animation: moleculeFloat 8s ease-in-out infinite;
    }
    
    .floating-molecule::before {
      content: '';
      position: absolute;
      top: 50%; left: 50%;
      transform: translate(-50%, -50%);
      width: 4px; height: 4px;
      background: var(--accent-primary);
      border-radius: 50%;
    }
    
    @keyframes moleculeFloat {
      0%, 100% { transform: translateY(0) rotate(0deg); opacity: 0.5; }
      50% { transform: translateY(-30px) rotate(180deg); opacity: 0.8; }
    }
    
    /* Neural Background */
    .neural-bg {
      position: fixed;
      top: 0;
      left: calc(var(--sidebar-width));
      width: calc(100% - 2 * var(--sidebar-width));
      height: 100%;
      z-index: 0;
      overflow: hidden;
    }
    
    .neuron {
      position: absolute;
      width: 4px; height: 4px;
      background: var(--accent-primary);
      border-radius: 50%;
      opacity: 0.4;
      animation: neuronPulse 4s ease-in-out infinite;
    }
    
    @keyframes neuronPulse {
      0%, 100% { opacity: 0.2; transform: scale(1); }
      50% { opacity: 0.6; transform: scale(1.5); }
    }
    
    /* Navigation */
    .nav-container {
      position: fixed;
      top: 0;
      left: var(--sidebar-width);
      right: var(--sidebar-width);
      height: var(--nav-height);
      z-index: 100;
      background: var(--bg-glass);
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
      border-bottom: 1px solid var(--border-subtle);
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0 40px;
    }
    
    .nav-brand {
      display: flex;
      align-items: center;
      gap: 12px;
      text-decoration: none;
      color: var(--text-primary);
    }
    
    .nav-logo {
      width: 42px; height: 42px;
      background: linear-gradient(135deg, var(--accent-primary), var(--accent-tertiary));
      border-radius: 12px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-family: var(--font-tech);
      font-weight: 900;
      font-size: 16px;
      color: var(--bg-deep);
      position: relative;
      overflow: hidden;
    }
    
    .nav-logo::before {
      content: '';
      position: absolute;
      top: -50%; left: -50%;
      width: 200%; height: 200%;
      background: conic-gradient(from 0deg, transparent, rgba(255,255,255,0.3), transparent);
      animation: logoShine 4s linear infinite;
    }
    
    @keyframes logoShine {
      0% { transform: rotate(0deg); }
      100% { transform: rotate(360deg); }
    }
    
    .nav-title {
      font-family: var(--font-heading);
      font-size: 22px;
      font-weight: 700;
      letter-spacing: -0.5px;
    }
    
    .nav-title span { color: var(--accent-primary); }
    
    .nav-links {
      display: flex;
      align-items: center;
      gap: 8px;
    }
    
    .nav-link {
      display: flex;
      align-items: center;
      gap: 6px;
      padding: 10px 18px;
      text-decoration: none;
      color: var(--text-secondary);
      font-size: 14px;
      font-weight: 500;
      border-radius: 10px;
      transition: all 0.3s ease;
    }
    
    .nav-link:hover {
      color: var(--text-primary);
      background: var(--bg-glass-light);
    }
    
    .nav-link.active {
      color: var(--accent-primary);
      background: rgba(0, 229, 255, 0.08);
    }
    
    .nav-link .material-icons-round { font-size: 18px; }
    
    .workspace-btn {
      display: flex;
      align-items: center;
      gap: 8px;
      padding: 12px 24px;
      background: linear-gradient(135deg, var(--accent-primary), var(--accent-tertiary));
      color: var(--bg-deep);
      font-weight: 600;
      font-size: 14px;
      border: none;
      border-radius: 12px;
      cursor: pointer;
      transition: all 0.3s ease;
      box-shadow: 0 0 30px rgba(0, 229, 255, 0.3);
    }
    
    .workspace-btn:hover {
      transform: translateY(-2px);
      box-shadow: 0 0 40px rgba(0, 229, 255, 0.5);
    }
    
    .user-profile {
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 8px 16px 8px 8px;
      background: var(--bg-glass-light);
      border: 1px solid var(--border-subtle);
      border-radius: 50px;
      cursor: pointer;
      transition: all 0.3s ease;
    }
    
    .user-profile:hover {
      border-color: var(--accent-primary);
      box-shadow: 0 0 20px rgba(0, 229, 255, 0.2);
    }
    
    .user-avatar {
      width: 36px; height: 36px;
      border-radius: 50%;
      background: linear-gradient(135deg, var(--accent-primary), var(--accent-pink));
      display: flex;
      align-items: center;
      justify-content: center;
      font-family: var(--font-heading);
      font-weight: 700;
      font-size: 14px;
      color: white;
      position: relative;
    }
    
    .user-avatar::after {
      content: '';
      position: absolute;
      bottom: 0; right: 0;
      width: 10px; height: 10px;
      background: var(--accent-green);
      border-radius: 50%;
      border: 2px solid var(--bg-primary);
    }
    
    .user-info { display: flex; flex-direction: column; gap: 2px; }
    .user-name { font-size: 13px; font-weight: 600; color: var(--text-primary); }
    .user-role { font-size: 11px; color: var(--accent-primary); font-family: var(--font-mono); }
    
    .theme-toggle {
      width: 44px; height: 44px;
      border-radius: 12px;
      background: var(--bg-glass-light);
      border: 1px solid var(--border-subtle);
      color: var(--text-secondary);
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: all 0.3s ease;
    }
    
    .theme-toggle:hover {
      color: var(--accent-primary);
      border-color: var(--accent-primary);
    }
    
    /* Page Navigation */
    .page-nav-bar {
      position: fixed;
      top: calc(var(--nav-height) + 16px);
      left: 50%;
      transform: translateX(-50%);
      z-index: 90;
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 10px 20px;
      background: var(--bg-glass);
      backdrop-filter: blur(16px);
      border: 1px solid var(--border-subtle);
      border-radius: 50px;
    }
    
    .page-nav-btn {
      display: flex;
      align-items: center;
      gap: 8px;
      padding: 8px 16px;
      background: transparent;
      border: 1px solid var(--border-subtle);
      border-radius: 25px;
      color: var(--text-secondary);
      font-size: 13px;
      font-weight: 500;
      cursor: pointer;
      transition: all 0.3s ease;
      text-decoration: none;
    }
    
    .page-nav-btn:hover {
      background: var(--bg-glass-light);
      border-color: var(--accent-primary);
      color: var(--accent-primary);
    }
    
    .page-indicator {
      font-size: 12px;
      color: var(--text-muted);
      font-family: var(--font-mono);
      padding: 0 8px;
    }
    
    /* Main Content */
    .main-content {
      position: relative;
      z-index: 10;
      margin-left: var(--sidebar-width);
      margin-right: var(--sidebar-width);
      padding-top: calc(var(--nav-height) + 24px);
      min-height: 100vh;
    }
    
    /* About Hero */
    .about-hero {
      padding: 80px 60px;
      text-align: center;
    }
    
    .hero-badge {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 8px 20px;
      background: rgba(0, 229, 255, 0.1);
      border: 1px solid rgba(0, 229, 255, 0.3);
      border-radius: 50px;
      font-size: 13px;
      font-weight: 500;
      color: var(--accent-primary);
      margin-bottom: 32px;
      font-family: var(--font-mono);
    }
    
    .hero-badge .pulse-dot {
      width: 8px; height: 8px;
      background: var(--accent-primary);
      border-radius: 50%;
      animation: pulse 2s ease-in-out infinite;
    }
    
    @keyframes pulse {
      0%, 100% { opacity: 1; transform: scale(1); }
      50% { opacity: 0.5; transform: scale(1.5); }
    }
    
    .about-title {
      font-family: var(--font-heading);
      font-size: clamp(42px, 6vw, 72px);
      font-weight: 900;
      line-height: 1.05;
      margin-bottom: 24px;
      letter-spacing: -2px;
    }
    
    .about-title .gradient-text {
      background: linear-gradient(135deg, var(--accent-primary), var(--accent-tertiary), var(--accent-pink));
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }
    
    .about-subtitle {
      font-size: clamp(17px, 2vw, 22px);
      color: var(--text-secondary);
      max-width: 700px;
      margin: 0 auto 48px;
      line-height: 1.6;
    }
    
    /* Mission Section */
    .mission-section {
      padding: 80px 60px;
      max-width: 1200px;
      margin: 0 auto;
    }
    
    .section-header {
      text-align: center;
      margin-bottom: 64px;
    }
    
    .section-tag {
      font-family: var(--font-mono);
      font-size: 13px;
      color: var(--accent-primary);
      text-transform: uppercase;
      letter-spacing: 2px;
      margin-bottom: 16px;
    }
    
    .section-title {
      font-family: var(--font-heading);
      font-size: clamp(32px, 4vw, 48px);
      font-weight: 800;
      margin-bottom: 20px;
      letter-spacing: -1px;
    }
    
    .section-desc {
      font-size: 18px;
      color: var(--text-secondary);
      max-width: 650px;
      margin: 0 auto;
      line-height: 1.7;
    }
    
    /* Values Grid */
    .values-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
      gap: 28px;
      margin-top: 48px;
    }
    
    .value-card {
      background: var(--bg-glass);
      backdrop-filter: blur(20px);
      border: 1px solid var(--border-subtle);
      border-radius: 24px;
      padding: 36px;
      transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
      position: relative;
      overflow: hidden;
    }
    
    .value-card::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      height: 3px;
      background: linear-gradient(90deg, var(--accent-primary), var(--accent-tertiary));
      opacity: 0;
      transition: opacity 0.3s ease;
    }
    
    .value-card:hover {
      transform: translateY(-8px);
      border-color: var(--accent-primary);
      box-shadow: 0 20px 60px rgba(0, 229, 255, 0.15);
    }
    
    .value-card:hover::before {
      opacity: 1;
    }
    
    .value-icon {
      width: 56px;
      height: 56px;
      border-radius: 16px;
      background: linear-gradient(135deg, rgba(0, 229, 255, 0.15), rgba(167, 139, 250, 0.15));
      display: flex;
      align-items: center;
      justify-content: center;
      margin-bottom: 24px;
    }
    
    .value-icon .material-icons-round {
      font-size: 28px;
      color: var(--accent-primary);
    }
    
    .value-title {
      font-size: 20px;
      font-weight: 700;
      margin-bottom: 12px;
    }
    
    .value-desc {
      font-size: 15px;
      color: var(--text-secondary);
      line-height: 1.7;
    }
    
    /* Team Section */
    .team-section {
      padding: 80px 60px;
      background: var(--bg-glass-light);
      border-top: 1px solid var(--border-subtle);
      border-bottom: 1px solid var(--border-subtle);
    }
    
    .team-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
      gap: 28px;
      max-width: 1200px;
      margin: 64px auto 0;
    }
    
    .team-member {
      background: var(--bg-glass);
      backdrop-filter: blur(20px);
      border: 1px solid var(--border-subtle);
      border-radius: 24px;
      padding: 32px;
      text-align: center;
      transition: all 0.3s ease;
    }
    
    .team-member:hover {
      border-color: var(--accent-primary);
      transform: translateY(-4px);
    }
    
    .member-avatar {
      width: 96px;
      height: 96px;
      border-radius: 50%;
      margin: 0 auto 20px;
      background: linear-gradient(135deg, var(--accent-primary), var(--accent-tertiary));
      display: flex;
      align-items: center;
      justify-content: center;
      font-family: var(--font-heading);
      font-weight: 700;
      font-size: 32px;
      color: white;
      position: relative;
    }
    
    .member-avatar::after {
      content: '';
      position: absolute;
      bottom: 4px;
      right: 4px;
      width: 16px;
      height: 16px;
      background: var(--accent-green);
      border-radius: 50%;
      border: 3px solid var(--bg-glass);
    }
    
    .member-name {
      font-size: 18px;
      font-weight: 700;
      margin-bottom: 6px;
    }
    
    .member-role {
      font-size: 14px;
      color: var(--accent-primary);
      font-family: var(--font-mono);
      margin-bottom: 12px;
    }
    
    .member-bio {
      font-size: 14px;
      color: var(--text-secondary);
      line-height: 1.6;
    }
    
    /* Timeline Section */
    .timeline-section {
      padding: 80px 60px;
      max-width: 900px;
      margin: 0 auto;
    }
    
    .timeline-item {
      display: flex;
      gap: 32px;
      padding: 32px 0;
      border-bottom: 1px solid var(--border-subtle);
    }
    
    .timeline-year {
      font-family: var(--font-tech);
      font-size: 18px;
      font-weight: 700;
      color: var(--accent-primary);
      min-width: 80px;
    }
    
    .timeline-content h4 {
      font-size: 18px;
      font-weight: 600;
      margin-bottom: 8px;
    }
    
    .timeline-content p {
      font-size: 15px;
      color: var(--text-secondary);
      line-height: 1.7;
    }
    
    /* CTA Section */
    .cta-section {
      padding: 80px 60px;
      text-align: center;
    }
    
    .cta-box {
      max-width: 700px;
      margin: 0 auto;
      padding: 64px;
      background: linear-gradient(135deg, rgba(0, 229, 255, 0.08), rgba(167, 139, 250, 0.08));
      border: 1px solid var(--border-subtle);
      border-radius: 32px;
      position: relative;
      overflow: hidden;
    }
    
    .cta-box::before {
      content: '';
      position: absolute;
      top: -50%;
      left: -50%;
      width: 200%;
      height: 200%;
      background: conic-gradient(from 0deg, transparent, rgba(0, 229, 255, 0.1), transparent, rgba(167, 139, 250, 0.1), transparent);
      animation: ctaRotate 15s linear infinite;
    }
    
    @keyframes ctaRotate {
      0% { transform: rotate(0deg); }
      100% { transform: rotate(360deg); }
    }
    
    .cta-content {
      position: relative;
      z-index: 1;
    }
    
    .cta-title {
      font-family: var(--font-heading);
      font-size: 36px;
      font-weight: 800;
      margin-bottom: 16px;
    }
    
    .cta-desc {
      font-size: 17px;
      color: var(--text-secondary);
      margin-bottom: 32px;
    }
    
    .btn-primary {
      display: inline-flex;
      align-items: center;
      gap: 10px;
      padding: 18px 36px;
      background: linear-gradient(135deg, var(--accent-primary), var(--accent-secondary));
      color: var(--bg-deep);
      font-size: 16px;
      font-weight: 600;
      border: none;
      border-radius: 14px;
      cursor: pointer;
      transition: all 0.3s ease;
      text-decoration: none;
    }
    
    .btn-primary:hover {
      transform: translateY(-4px);
      box-shadow: 0 20px 40px rgba(0, 229, 255, 0.35);
    }
    
    /* Footer */
    .footer {
      padding: 60px;
      border-top: 1px solid var(--border-subtle);
      background: var(--bg-glass);
    }
    
    .footer-content {
      display: grid;
      grid-template-columns: 2fr repeat(3, 1fr);
      gap: 48px;
      max-width: 1200px;
      margin: 0 auto;
    }
    
    .footer-brand { display: flex; flex-direction: column; gap: 20px; }
    
    .footer-logo {
      display: flex;
      align-items: center;
      gap: 12px;
    }
    
    .footer-logo-icon {
      width: 40px; height: 40px;
      background: linear-gradient(135deg, var(--accent-primary), var(--accent-tertiary));
      border-radius: 10px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-family: var(--font-tech);
      font-weight: 900;
      font-size: 14px;
      color: var(--bg-deep);
    }
    
    .footer-logo-text {
      font-family: var(--font-heading);
      font-size: 20px;
      font-weight: 700;
    }
    
    .footer-desc {
      font-size: 14px;
      color: var(--text-muted);
      line-height: 1.7;
    }
    
    .footer-column h4 {
      font-size: 14px;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 1px;
      margin-bottom: 20px;
      color: var(--text-primary);
    }
    
    .footer-links {
      display: flex;
      flex-direction: column;
      gap: 12px;
    }
    
    .footer-links a {
      color: var(--text-muted);
      text-decoration: none;
      font-size: 14px;
      transition: color 0.2s ease;
    }
    
    .footer-links a:hover { color: var(--accent-primary); }
    
    .footer-links::-webkit-scrollbar { height: 6px; }
    .footer-links::-webkit-scrollbar-thumb { background: var(--accent); border-radius: 3px; }
    
    .footer-bottom {
      margin-top: 48px;
      padding-top: 24px;
      border-top: 1px solid var(--border-subtle);
      display: flex;
      justify-content: space-between;
      align-items: center;
      font-size: 13px;
      color: var(--text-muted);
    }
    
    .footer-social { display: flex; gap: 16px; }
    .footer-social a { color: var(--text-muted); transition: color 0.2s ease; }
    .footer-social a:hover { color: var(--accent-primary); }
    
    /* Responsive */
    @media (max-width: 1024px) {
      :root { --sidebar-width: 60px; }
      .molecular-sidebar { width: 60px; }
      .dna-helix { width: 40px; }
      .nucleotide { width: 8px; height: 8px; }
      .nav-container { padding: 0 20px; }
      .nav-links { display: none; }
      .main-content { padding-left: 20px; padding-right: 20px; }
      .about-hero, .mission-section, .team-section, .timeline-section { padding-left: 30px; padding-right: 30px; }
      .footer-content { grid-template-columns: 1fr 1fr; }
    }
    
    @media (max-width: 768px) {
      :root { --sidebar-width: 0px; --nav-height: 70px; }
      .molecular-sidebar { display: none; }
      .neural-bg { width: 100%; left: 0; }
      .main-content { margin-left: 0; margin-right: 0; }
      .nav-container { left: 0; right: 0; padding: 0 16px; }
      .page-nav-bar { display: none; }
      .about-title { font-size: 32px; }
      .values-grid, .team-grid { grid-template-columns: 1fr; }
      .timeline-item { flex-direction: column; gap: 12px; }
      .footer-content { grid-template-columns: 1fr; gap: 32px; }
      .footer-bottom { flex-direction: column; gap: 16px; text-align: center; }
    }
  </style>
