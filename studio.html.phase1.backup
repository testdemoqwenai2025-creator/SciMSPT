}

function createNewFile() {
  const filename = prompt('Enter file name:', 'untitled.py');
  if (filename) {
    state.files[filename] = '';
    openFile(null, filename);
  }
}

function createNewFolder() {
  alert('Folder creation coming soon! For now, use the terminal.');
}

function refreshFileTree() {
  // Refresh animation
  const tree = document.getElementById('file-tree');
  tree.style.opacity = '0.5';
  setTimeout(() => tree.style.opacity = '1', 300);
}

function showWelcomeScreen() {
  document.getElementById('welcome-screen').style.display = 'flex';
  document.getElementById('monaco-editor').style.display = 'none';
  state.activeFile = null;
  document.getElementById('currentFile').textContent = 'Welcome';
}

function updateStatusBar() {
  const langMap = {
    py: 'Python', js: 'JavaScript', ts: 'TypeScript',
    json: 'JSON', md: 'Markdown', csv: 'CSV',
    html: 'HTML', css: 'CSS', sh: 'Shell'
  };
  
  if (state.activeFile) {
    const ext = state.activeFile.split('.').pop();
    document.getElementById('status-language').textContent = langMap[ext] || 'Plain Text';
  }
}

// Sidebar Toggle
function toggleSidebar(type) {
  const sidebar = document.getElementById('sidebar-explorer');
  sidebar.style.display = sidebar.style.display === 'none' ? 'flex' : 'none';
}

// Panel Tab Switching
function switchPanelTab(tabId) {
  document.querySelectorAll('.panel-tab').forEach(t => t.classList.remove('active'));
  document.querySelectorAll('.panel-content').forEach(p => p.classList.remove('active'));
  
  event.target.closest('.panel-tab').classList.add('active');
  document.getElementById('panel-' + tabId).classList.add('active');
}

function openTerminalPanel() {
  switchPanelTab('terminal');
}

// AI Functions
let selectedProviders = ['gemini'];

function selectProvider(chip, provider) {
  document.querySelectorAll('.provider-chip').forEach(c => c.classList.remove('active'));
  chip.classList.add('active');
  state.currentProvider = provider;
  document.getElementById('status-ai').textContent = `AI: ${provider.charAt(0).toUpperCase() + provider.slice(1)}`;
  
  // Update AI welcome message
  updateAIWelcome(provider);
}

function selectModalProvider(card, provider) {
  card.classList.toggle('selected');
  
  if (card.classList.contains('selected')) {
    if (!selectedProviders.includes(provider)) {
      selectedProviders.push(provider);
    }
  } else {
    selectedProviders = selectedProviders.filter(p => p !== provider);
  }
}

function updateAIWelcome(provider) {
  const names = {
    gemini: 'Gemini (Google)',
    grok: 'Grok (xAI)',
    chatgpt: 'ChatGPT (OpenAI)',
    qwen: 'Qwen (Alibaba)',
    minimax: 'MiniMax',
    claude: 'Claude (Anthropic)'
  };
  
  // Add new message indicating provider switch
  addAIMessage(`Switched to ${names[provider] || provider}. How can I help?`, true);
}

function sendChatMessage() {
  const input = document.getElementById('chat-input');
  const message = input.value.trim();
  
  if (!message) return;
  
  // Add user message
  addUserMessage(message);
  input.value = '';
  
  // Simulate AI response (in production, this would call the actual API)
  simulateAIResponse(message);
}

function addUserMessage(text) {
  const messagesContainer = document.getElementById('chat-messages');
  const msgDiv = document.createElement('div');
  msgDiv.className = 'chat-message user';
  msgDiv.innerHTML = `<div class="sender">You</div><div>${escapeHtml(text)}</div>`;
  messagesContainer.appendChild(msgDiv);
  messagesContainer.scrollTop = messagesContainer.scrollHeight;
}

function addAIMessage(text, isSystem = false) {
  const messagesContainer = document.getElementById('chat-messages');
  const msgDiv = document.createElement('div');
  msgDiv.className = 'chat-message ai';
  const senderName = isSystem ? 'System' : `🤖 AI (${state.currentProvider.charAt(0).toUpperCase() + state.currentProvider.slice(1)})`;
  msgDiv.innerHTML = `<div class="sender">${senderName}</div><div>${text}</div>`;
  messagesContainer.appendChild(msgDiv);
  messagesContainer.scrollTop = messagesContainer.scrollHeight;
}

function escapeHtml(text) {
  const div = document.createElement('div');
  div.textContent = text;
  return div.innerHTML.replace(/\n/g, '<br>');
}

function simulateAIResponse(userMessage) {
  const lowerMsg = userMessage.toLowerCase();
  let response = '';
  
  // Simple pattern matching for demo (production would use actual AI API)
  if (lowerMsg.includes('hello') || lowerMsg.includes('hi')) {
    response = `Hello! 👋 I'm your SciMSPT AI assistant powered by <strong>${state.currentProvider}</strong>.<br><br>I can help you with:<br>• 📄 Research paper analysis<br>• 💻 Code generation and debugging<br>• 📊 Data visualization<br>• 🔬 Scientific concept explanation<br><br>What would you like to explore today?`;
  }
  else if (lowerMsg.includes('paper') || lowerMsg.includes('research')) {
    response = `Great question about research papers! 📄<br><br>I can help you analyze papers from:<br>• <strong>arXiv</strong> - Physics, CS, Math preprints<br>• <strong>bioRxiv</strong> - Biology & medicine<br>• <strong>ScienceDaily</strong> - News & breakthroughs<br><br>To analyze a specific paper, provide its DOI or title, and I'll fetch the abstract, extract key findings, and assess venture potential.`;
  }
  else if (lowerMsg.includes('code') || lowerMsg.includes('python')) {
    response = `Ready to help with code! 💻<br><br>Here's a sample analysis script you can run:<br><pre style='background:#1e1e1e;padding:12px;border-radius:8px;margin-top:8px;color:#d4d4d4;font-size:12px;'>from scimspt import PaperAnalyzer

analyzer = PaperAnalyzer()
result = analyzer.analyze(
    doi="10.1038/s41586-024-07890-1",
    include_venture_score=True
)

print(f"Title: {result.title}")
print(f"Venture Score: {result.venture_score}/100")</pre><br>Would you like me to explain any part of this code?`;
  }
  else if (lowerMsg.includes('startup') || lowerMsg.includes('venture')) {
    response = `Venture intelligence is my specialty! 🚀<br><br>This week's fundable startups include:<br>1. <strong>Stellarator Fusion</strong> - $589M NPV<br>2. <strong>Solid-State Battery</strong> - $587M NPV<br>3. <strong>Room-Temp Quantum Materials</strong> - 34.3% IRR<br><br>Each startup is backed by multiple peer-reviewed papers. Would you like detailed analysis of any specific opportunity?`;
  }
  else if (lowerMsg.includes('help') || lowerMsg.includes('what can')) {
    response = `Here's what I can do for you:<br><br>🔬 <strong>Research Tools</strong><br>&nbsp;&nbsp;• Fetch papers from arXiv, bioRxiv<br>&nbsp;&nbsp;• Parse ScienceDaily RSS feeds<br>&nbsp;&nbsp;• Extract key findings automatically<br><br>💻 <strong>Development</strong><br>&nbsp;&nbsp;• Generate Python/JS analysis code<br>&nbsp;&nbsp;• Debug and optimize scripts<br>&nbsp;&nbsp;• Create visualizations<br><br>📊 <strong>Analysis</strong><br>&nbsp;&nbsp;• Calculate venture scores<br>&nbsp;&nbsp;• Identify market opportunities<br>&nbsp;&nbsp;• Compare startups<br><br>Just ask me anything!`;
  }
  else {
    response = `I understand you're asking about: "${userMessage}"<br><br>Using <strong>${state.currentProvider}</strong>, I'm analyzing your query against our research database...<br><br>In the full version, this would connect to the actual AI API to provide a contextual response based on current research papers and market data.<br><br>For now, try asking me about:<br>• Specific research papers (by DOI or topic)<br>• Code examples for analysis<br>• Startup opportunity assessment`;
  }
  
  // Simulate typing delay
  setTimeout(() => {
    addAIMessage(response);
  }, 800 + Math.random() * 500);
}

// Terminal Functions
function handleTerminalInput(event) {
  if (event.key === 'Enter') {
    executeCommand();
  }
}

function executeCommand() {
  const input = document.getElementById('terminal-input');
  const command = input.value.trim();
  const output = document.getElementById('terminal-output');
  
  if (!command) return;
  
  // Add command to terminal
  const cmdLine = document.createElement('div');
  cmdLine.className = 'terminal-line';
  cmdLine.innerHTML = `<span class="terminal-prompt">SciMSPT@studio ~ %</span><span class="terminal-command">${escapeHtml(command)}</span>`;
  output.appendChild(cmdLine);
  
  // Process command
  let result = '';
  
  switch(command.split(' ')[0]) {
    case 'help':
      result = `Available commands:
  help          - Show this help
  clear         - Clear terminal
  ls             - List files
  cat <file>     - View file content
  api-status    - Check API connectivity
  fetch <doi>   - Fetch paper by DOI
  analyze       - Run quick analysis
  upgrade       - View subscription options`;
      break;
      
    case 'clear':
      output.innerHTML = '';
      input.value = '';
      return;
      
    case 'ls':
      result = `drwxr-xr-x  research-papers/
drwxr-xr-x  scripts/
drwxr-xr-x  notebooks/
-rw-r--r--  README.md
-rw-r--r--  config.json
-rw-r--r--  sample.py  ← (new)`;
      break;
      
    case 'cat':
      const fileName = command.split(' ')[1];
      if (fileName && state.files[fileName]) {
        result = state.files[fileName].substring(0, 500) + (state.files[fileName].length > 500 ? '\n... (truncated)' : '');
      } else {
        result = `cat: ${fileName}: No such file`;
      }
      break;
      
    case 'api-status':
      result = `Checking API connectivity...

✓ ScienceDaily RSS    - Connected (free tier)
✓ arXiv OAI-PMH       - Connected (rate limited)
✓ bioRxiv API         - Connected (free tier)
✓ Crossref DOI        - Connected (unlimited)
✓ chemRxiv           - Connected (free tier)

All systems operational. Ready for queries.`;
      break;
      
    case 'fetch':
      const doi = command.split(' ')[1];
      if (doi) {
        result = `Fetching paper: ${doi}...
        
Title: [Paper title would appear here]
Authors: [Author list]
Year: 2024
Venue: Nature

Abstract: [Full abstract from API]

Venture Score: 82/100
Fundable Domains: quantum-computing, energy-storage

Use 'analyze' for full breakdown.`;
      } else {
        result = 'Usage: fetch <doi-or-id>';
      }
      break;
      
    case 'analyze':
      result = `Running analysis pipeline...

┌─────────────────────────────────────┐
│     SCI MSPT ANALYSIS ENGINE        │
├─────────────────────────────────────┤
│ Papers analyzed: 47                 │
│ Total citations: 1,243              │
│ Emerging trends: 3                   │
│ Venture opportunities: 7             │
└─────────────────────────────────────┘

Top opportunities:
1. Room-Temp Superconductors (NPV: $107M)
2. Solid-State Batteries (NPV: $587M)
3. Stellarator Fusion (NPV: $589M)

Run 'fetch <DOI>' for detailed analysis.`;
      break;
      
    case 'upgrade':
      showSubscriptionModal();
      result = 'Opening subscription modal...';
      break;
      
    default:
      result = `bash: ${command}: command not found
Type 'help' for available commands.`;
  }
  
  // Add output
  const outLine = document.createElement('div');
  outLine.className = 'terminal-output';
  outLine.innerHTML = escapeHtml(result).replace(/\n/g, '<br>');
  output.appendChild(outLine);
  
  output.scrollTop = output.scrollHeight;
  input.value = '';
}

// Modal Functions
function openAIScopeModal() {
  document.getElementById('ai-scope-modal').classList.add('active');
}

function closeAIScopeModal() {
  document.getElementById('ai-scope-modal').classList.remove('active');
}

function saveAIScopeSelection() {
  if (selectedProviders.length === 0) {
    alert('Please select at least one AI provider');
    return;
  }
  
  state.currentProvider = selectedProviders[0];
  document.getElementById('status-ai').textContent = `AI: ${state.currentProvider.charAt(0).toUpperCase() + state.currentProvider.slice(1)} (+${selectedProviders.length - 1})`;
  
  closeAIScopeModal();
  
  // Show confirmation
  addAIMessage(`AI scope updated! Primary: <strong>${state.currentProvider}</strong>. Selected providers: ${selectedProviders.join(', ')}.`);
}

function showSubscriptionModal() {
  document.getElementById('subscription-modal').classList.add('active');
}

function closeSubscriptionModal() {
  document.getElementById('subscription-modal').classList.remove('active');
}

function openLoginModal() {
  alert('Login modal would open here.\n\nOptions:\n• GitHub OAuth\n• Google Sign-in\n• Email/password\n\nFor demo purposes, click the User avatar (U) to toggle login state.');
}

function toggleUserMenu() {
  state.isLoggedIn = !state.isLoggedIn;
  const avatar = document.querySelector('.user-avatar');
  
  if (state.isLoggedIn) {
    avatar.textContent = 'JD'; // Would be user initials
    avatar.style.background = 'linear-gradient(135deg, #10b981, #059669)';
    addAIMessage('Welcome back! Your session has been restored. All files are synced.', true);
  } else {
    avatar.textContent = 'U';
    avatar.style.background = 'linear-gradient(135deg, var(--accent), #a78bfa)';
  }
}

// Keyboard shortcuts
document.addEventListener('keydown', (e) => {
  // Ctrl+S to save
  if ((e.ctrlKey || e.metaKey) && e.key === 's') {
    e.preventDefault();
    if (state.activeFile) {
      // Save to localStorage
      localStorage.setItem(`scimspt-file-${state.activeFile}`, state.files[state.activeFile]);
      addAIMessage(`💾 File saved: ${state.activeFile}`, true);
    }
  }
  
  // Ctrl+P to open AI Scope
  if ((e.ctrlKey || e.metaKey) && e.key === 'p') {
    e.preventDefault();
    openAIScopeModal();
  }
  
  // Escape to close modals
  if (e.key === 'Escape') {
    closeAIScopeModal();
    closeSubscriptionModal();
  }
});

// Initialize
(function init() {
  // Load theme preference
  const savedTheme = localStorage.getItem('scimspt-theme');
  if (savedTheme) {
    document.documentElement.setAttribute('data-theme', savedTheme);
    document.getElementById('themeIcon').textContent = savedTheme === 'dark' ? 'dark_mode' : 'light_mode';
  }
  
  // Load saved files from localStorage
  for (let i = 0; i < localStorage.length; i++) {
    const key = localStorage.key(i);
    if (key.startsWith('scimspt-file-')) {
      const filename = key.replace('scimspt-file-', '');
      state.files[filename] = localStorage.getItem(key);
    }
  }
  
  console.log('SciMSPT Studio initialized');
  console.log('Available commands: help, ls, cat, fetch, analyze, api-status, upgrade');
})();
</script>

