              <p class="endpoint-desc">Retrieve detailed information about an analyzed paper</p>
            </div>
            
            <div class="endpoint-card">
              <span class="endpoint-method get">GET</span>
              <span class="endpoint-path">/v1/startups/weekly</span>
              <p class="endpoint-desc">Get this week's validated startup opportunities</p>
            </div>
            
            <div class="endpoint-card">
              <span class="endpoint-method post">POST</span>
              <span class="endpoint-path">/v1/pipelines/run</span>
              <p class="endpoint-desc">Execute a custom analysis pipeline</p>
            </div>
          </div>
        </section>

