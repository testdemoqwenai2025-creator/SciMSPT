<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>SciMSPT — Neural Research Intelligence Platform</title>
  <meta name="description" content="SciMSPT: Where molecular intelligence meets investment foresight. AI-powered research analysis platform transforming scientific discovery into strategic opportunities.">
  
  <!-- Fonts -->
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;700;900&family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500;600&family=Orbitron:wght@400;700;900&display=swap" rel="stylesheet">
  <link href="https://fonts.googleapis.com/icon?family=Material+Icons+Round" rel="stylesheet">
  
  <style>
    /* ============================================
       SCIMSPT NEURAL DESIGN SYSTEM v3.0
       Molecular Intelligence Interface
       ============================================ */
    
    :root {
      --bg-deep: #030810;
      --bg-primary: #0a1628;
      --bg-secondary: #0d1f35;
      --bg-tertiary: #122a45;
      --bg-glass: rgba(10, 22, 40, 0.85);
      --bg-glass-light: rgba(255, 255, 255, 0.03);
      
      --accent-primary: #00E5FF;
      --accent-secondary: #4da8da;
      --accent-tertiary: #a78bfa;
      --accent-pink: #f472b6;
      --accent-green: #10b981;
      --accent-gold: #f59e0b;
      
      --text-primary: #e8f4fc;
      --text-secondary: #94a3b8;
      --text-muted: #64748b;
      
      --border-subtle: rgba(0, 229, 255, 0.15);
      --border-glow: rgba(0, 229, 255, 0.4);
      
      --font-heading: 'Playfair Display', Georgia, serif;
      --font-body: 'Inter', -apple-system, sans-serif;
      --font-mono: 'JetBrains Mono', monospace;
      --font-tech: 'Orbitron', sans-serif;
      
      --nav-height: 80px;
      --sidebar-width: 100px;
      
      --glow-primary: 0 0 30px rgba(0, 229, 255, 0.3);
      --glow-secondary: 0 0 60px rgba(167, 139, 250, 0.2);
    }
    
    [data-theme="light"] {
      --bg-deep: #f0f4f8;
      --bg-primary: #ffffff;
      --bg-secondary: #f8fafc;
      --bg-tertiary: #e2e8f0;
      --bg-glass: rgba(255, 255, 255, 0.92);
      --bg-glass-light: rgba(0, 0, 0, 0.02);
      --text-primary: #0f172a;
      --text-secondary: #475569;
      --text-muted: #94a3b8;
      --border-subtle: rgba(77, 168, 218, 0.25);
    }
    
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }
    
    html {
      scroll-behavior: smooth;
    }
    
    body {
      font-family: var(--font-body);
      background: var(--bg-deep);
      color: var(--text-primary);
      line-height: 1.6;
      overflow-x: hidden;
      min-height: 100vh;
    }
    
    /* ============================================
       MOLECULAR SIDE BARS - DNA/RNA VISUALIZATION
       ============================================ */
    
    .molecular-sidebar {
      position: fixed;
      top: 0;
      width: var(--sidebar-width);
      height: 100vh;
      z-index: 5;
      pointer-events: none;
      overflow: hidden;
    }
    
    .molecular-sidebar.left {
      left: 0;
      background: linear-gradient(
        90deg,
        rgba(0, 229, 255, 0.08) 0%,
        transparent 100%
      );
      border-right: 1px solid var(--border-subtle);
    }
    
    .molecular-sidebar.right {
      right: 0;
      background: linear-gradient(
        -90deg,
        rgba(167, 139, 250, 0.08) 0%,
        transparent 100%
      );
      border-left: 1px solid var(--border-subtle);
    }
    
    .dna-helix {
      position: absolute;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      width: 60px;
      height: 80vh;
    }
    
    .dna-strand {
      position: absolute;
      width: 100%;
      height: 100%;
    }
    
    .nucleotide {
      position: absolute;
      width: 12px;
      height: 12px;
      border-radius: 50%;
      animation: nucleotidePulse 3s ease-in-out infinite;
    }
    
    .nucleotide.adenine { background: var(--accent-primary); box-shadow: 0 0 10px var(--accent-primary); }
    .nucleotide.thymine { background: var(--accent-pink); box-shadow: 0 0 10px var(--accent-pink); }
    .nucleotide.guanine { background: var(--accent-tertiary); box-shadow: 0 0 10px var(--accent-tertiary); }
    .nucleotide.cytosine { background: var(--accent-green); box-shadow: 0 0 10px var(--accent-green); }
    
    @keyframes nucleotidePulse {
      0%, 100% { opacity: 0.6; transform: scale(1); }
      50% { opacity: 1; transform: scale(1.2); }
    }
    
    .backbone-line {
      position: absolute;
      width: 2px;
      height: 100%;
      left: 50%;
      background: linear-gradient(
        to bottom,
        transparent,
        var(--accent-primary) 20%,
        var(--accent-tertiary) 50%,
        var(--accent-pink) 80%,
        transparent
      );
      opacity: 0.3;
    }
    
    .protein-chain {
      position: absolute;
      width: 40px;
      height: 200px;
      top: 20%;
    }
    
    .amino-acid {
      position: absolute;
      width: 8px;
      height: 8px;
      border-radius: 2px;
      background: var(--accent-gold);
      opacity: 0.7;
      animation: aminoFloat 4s ease-in-out infinite;
    }
    
    @keyframes aminoFloat {
      0%, 100% { transform: translateX(0) rotate(0deg); }
      50% { transform: translateX(10px) rotate(180deg); }
    }
    
    /* Molecular Grid Pattern */
    .molecular-grid {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background-image: 
        radial-gradient(circle at 20% 30%, rgba(0, 229, 255, 0.05) 1px, transparent 1px),
        radial-gradient(circle at 70% 60%, rgba(167, 139, 250, 0.05) 1px, transparent 1px),
        radial-gradient(circle at 40% 80%, rgba(244, 114, 182, 0.05) 1px, transparent 1px);
      background-size: 30px 30px, 50px 50px, 40px 40px;
      animation: gridShift 20s linear infinite;
    }
    
    @keyframes gridShift {
      0% { transform: translateY(0); }
      100% { transform: translateY(30px); }
    }
    
    /* Floating Molecules */
    .floating-molecule {
      position: absolute;
      border: 1px solid var(--border-subtle);
      border-radius: 50%;
      animation: moleculeFloat 8s ease-in-out infinite;
    }
    
    .floating-molecule::before {
      content: '';
      position: absolute;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      width: 4px;
      height: 4px;
      background: var(--accent-primary);
      border-radius: 50%;
    }
    
    @keyframes moleculeFloat {
      0%, 100% { transform: translateY(0) rotate(0deg); opacity: 0.5; }
      50% { transform: translateY(-30px) rotate(180deg); opacity: 0.8; }
    }
    
    /* ============================================
       NEURAL NETWORK BACKGROUND
       ============================================ */
    
    .neural-bg {
      position: fixed;
      top: 0;
      left: 0;
      width: calc(100% - 2 * var(--sidebar-width));
      height: 100%;
      margin-left: var(--sidebar-width);
      z-index: 0;
      overflow: hidden;
    }
    
    .neuron {
      position: absolute;
      width: 4px;
      height: 4px;
      background: var(--accent-primary);
      border-radius: 50%;
      opacity: 0.4;
      animation: neuronPulse 4s ease-in-out infinite;
    }
    
    .synapse {
      position: absolute;
      height: 1px;
      background: linear-gradient(90deg, transparent, var(--accent-primary), transparent);
      opacity: 0.2;
      animation: synapseFire 3s ease-in-out infinite;
    }
    
    @keyframes neuronPulse {
      0%, 100% { opacity: 0.2; transform: scale(1); }
      50% { opacity: 0.6; transform: scale(1.5); }
    }
    
    @keyframes synapseFire {
      0%, 100% { opacity: 0.1; }
      50% { opacity: 0.4; }
    }
    
    /* ============================================
       NAVIGATION SYSTEM
       ============================================ */
    
    .nav-container {
      position: fixed;
      top: 0;
      left: var(--sidebar-width);
      right: var(--sidebar-width);
      height: var(--nav-height);
      z-index: 100;
      background: var(--bg-glass);
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
      border-bottom: 1px solid var(--border-subtle);
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0 40px;
    }
    
    .nav-brand {
      display: flex;
      align-items: center;
      gap: 12px;
      text-decoration: none;
      color: var(--text-primary);
    }
    
    .nav-logo {
      width: 42px;
      height: 42px;
      background: linear-gradient(135deg, var(--accent-primary), var(--accent-tertiary));
      border-radius: 12px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-family: var(--font-tech);
      font-weight: 900;
      font-size: 16px;
      color: var(--bg-deep);
      position: relative;
      overflow: hidden;
    }
    
    .nav-logo::before {
      content: '';
      position: absolute;
      top: -50%;
      left: -50%;
      width: 200%;
      height: 200%;
      background: conic-gradient(from 0deg, transparent, rgba(255,255,255,0.3), transparent);
      animation: logoShine 4s linear infinite;
    }
    
    @keyframes logoShine {
      0% { transform: rotate(0deg); }
      100% { transform: rotate(360deg); }
    }
    
    .nav-title {
      font-family: var(--font-heading);
      font-size: 22px;
      font-weight: 700;
      letter-spacing: -0.5px;
    }
    
    .nav-title span {
      color: var(--accent-primary);
    }
    
    .nav-links {
      display: flex;
      align-items: center;
      gap: 8px;
    }
    
    .nav-link {
      display: flex;
      align-items: center;
      gap: 6px;
      padding: 10px 18px;
      text-decoration: none;
      color: var(--text-secondary);
      font-size: 14px;
      font-weight: 500;
      border-radius: 10px;
      transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
      position: relative;
      overflow: hidden;
    }
    
    .nav-link::before {
      content: '';
      position: absolute;
      bottom: 0;
      left: 50%;
      transform: translateX(-50%);
      width: 0;
      height: 2px;
      background: var(--accent-primary);
      transition: width 0.3s ease;
    }
    
    .nav-link:hover {
      color: var(--text-primary);
      background: var(--bg-glass-light);
    }
    
    .nav-link:hover::before {
      width: 60%;
    }
    
    .nav-link.active {
      color: var(--accent-primary);
      background: rgba(0, 229, 255, 0.08);
    }
    
    .nav-link.active::before {
      width: 60%;
    }
    
    .nav-link .material-icons-round {
      font-size: 18px;
    }
    
    /* Workspace Button */
    .workspace-btn {
      display: flex;
      align-items: center;
      gap: 8px;
      padding: 12px 24px;
      background: linear-gradient(135deg, var(--accent-primary), var(--accent-tertiary));
      color: var(--bg-deep);
      font-weight: 600;
      font-size: 14px;
      border: none;
      border-radius: 12px;
      cursor: pointer;
      transition: all 0.3s ease;
      box-shadow: var(--glow-primary);
      position: relative;
      overflow: hidden;
    }
    
    .workspace-btn::before {
      content: '';
      position: absolute;
      top: 0;
      left: -100%;
      width: 100%;
      height: 100%;
      background: linear-gradient(90deg, transparent, rgba(255,255,255,0.3), transparent);
      transition: left 0.5s ease;
    }
    
    .workspace-btn:hover::before {
      left: 100%;
    }
    
    .workspace-btn:hover {
      transform: translateY(-2px);
      box-shadow: 0 0 40px rgba(0, 229, 255, 0.5);
    }
    
    /* User Profile Section */
    .user-section {
      display: flex;
      align-items: center;
      gap: 14px;
    }
    
    .user-profile {
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 8px 16px 8px 8px;
      background: var(--bg-glass-light);
      border: 1px solid var(--border-subtle);
      border-radius: 50px;
      cursor: pointer;
      transition: all 0.3s ease;
    }
    
    .user-profile:hover {
      border-color: var(--accent-primary);
      box-shadow: 0 0 20px rgba(0, 229, 255, 0.2);
    }
    
    .user-avatar {
      width: 36px;
      height: 36px;
      border-radius: 50%;
      background: linear-gradient(135deg, var(--accent-primary), var(--accent-pink));
      display: flex;
      align-items: center;
      justify-content: center;
      font-family: var(--font-heading);
      font-weight: 700;
      font-size: 14px;
      color: white;
      position: relative;
    }
    
    .user-avatar::after {
      content: '';
      position: absolute;
      bottom: 0;
      right: 0;
      width: 10px;
      height: 10px;
      background: var(--accent-green);
      border-radius: 50%;
      border: 2px solid var(--bg-primary);
    }
    
    .user-info {
      display: flex;
      flex-direction: column;
      gap: 2px;
    }
    
    .user-name {
      font-size: 13px;
      font-weight: 600;
      color: var(--text-primary);
    }
    
    .user-role {
      font-size: 11px;
      color: var(--accent-primary);
      font-family: var(--font-mono);
    }
    
    .user-dropdown {
      position: relative;
    }
    
    .dropdown-menu {
      position: absolute;
      top: calc(100% + 10px);
      right: 0;
      min-width: 240px;
      background: var(--bg-glass);
      backdrop-filter: blur(20px);
      border: 1px solid var(--border-subtle);
      border-radius: 16px;
      padding: 8px;
      opacity: 0;
      visibility: hidden;
      transform: translateY(-10px);
      transition: all 0.3s ease;
      z-index: 200;
    }
    
    .dropdown-menu.show {
      opacity: 1;
      visibility: visible;
      transform: translateY(0);
    }
    
    .dropdown-header {
      padding: 16px;
      border-bottom: 1px solid var(--border-subtle);
      margin-bottom: 8px;
    }
    
    .dropdown-user-name {
      font-weight: 600;
      font-size: 15px;
      margin-bottom: 4px;
    }
    
    .dropdown-user-email {
      font-size: 12px;
      color: var(--text-muted);
      font-family: var(--font-mono);
    }
    
    .dropdown-item {
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 12px 16px;
      color: var(--text-secondary);
      text-decoration: none;
      border-radius: 10px;
      transition: all 0.2s ease;
      font-size: 14px;
    }
    
    .dropdown-item:hover {
      background: var(--bg-glass-light);
      color: var(--text-primary);
    }
    
    .dropdown-item .material-icons-round {
      font-size: 20px;
      color: var(--accent-primary);
    }
    
    .dropdown-divider {
      height: 1px;
      background: var(--border-subtle);
      margin: 8px 0;
    }
    
    /* Theme Toggle */
    .theme-toggle {
      width: 44px;
      height: 44px;
      border-radius: 12px;
      background: var(--bg-glass-light);
      border: 1px solid var(--border-subtle);
      color: var(--text-secondary);
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: all 0.3s ease;
    }
    
    .theme-toggle:hover {
      color: var(--accent-primary);
      border-color: var(--accent-primary);
    }
    
    /* ============================================
       PAGE NAVIGATION BAR (Return/Home)
       ============================================ */
    
    .page-nav-bar {
      position: fixed;
      top: calc(var(--nav-height) + 16px);
      left: 50%;
      transform: translateX(-50%);
      z-index: 90;
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 10px 20px;
      background: var(--bg-glass);
      backdrop-filter: blur(16px);
      border: 1px solid var(--border-subtle);
      border-radius: 50px;
    }
    
    .page-nav-btn {
      display: flex;
      align-items: center;
      gap: 8px;
      padding: 8px 16px;
      background: transparent;
      border: 1px solid var(--border-subtle);
      border-radius: 25px;
      color: var(--text-secondary);
      font-size: 13px;
      font-weight: 500;
      cursor: pointer;
      transition: all 0.3s ease;
      text-decoration: none;
    }
    
    .page-nav-btn:hover {
      background: var(--bg-glass-light);
      border-color: var(--accent-primary);
      color: var(--accent-primary);
    }
    
    .page-nav-btn .material-icons-round {
      font-size: 18px;
    }
    
    .page-indicator {
      font-size: 12px;
      color: var(--text-muted);
      font-family: var(--font-mono);
      padding: 0 8px;
    }
    
    /* ============================================
       MAIN CONTENT AREA
       ============================================ */
    
    .main-content {
      position: relative;
      z-index: 10;
      margin-left: var(--sidebar-width);
      margin-right: var(--sidebar-width);
      padding-top: calc(var(--nav-height) + 24px);
      min-height: 100vh;
    }
    
    /* Hero Section */
    .hero-section {
      padding: 80px 60px;
      text-align: center;
      position: relative;
    }
    
    .hero-badge {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 8px 20px;
      background: rgba(0, 229, 255, 0.1);
      border: 1px solid rgba(0, 229, 255, 0.3);
      border-radius: 50px;
      font-size: 13px;
      font-weight: 500;
      color: var(--accent-primary);
      margin-bottom: 32px;
      font-family: var(--font-mono);
      letter-spacing: 0.5px;
    }
    
    .hero-badge .pulse-dot {
      width: 8px;
      height: 8px;
      background: var(--accent-primary);
      border-radius: 50%;
      animation: pulse 2s ease-in-out infinite;
    }
    
    @keyframes pulse {
      0%, 100% { opacity: 1; transform: scale(1); }
      50% { opacity: 0.5; transform: scale(1.5); }
    }
    
    .hero-title {
      font-family: var(--font-heading);
      font-size: clamp(48px, 7vw, 88px);
      font-weight: 900;
      line-height: 1.05;
      margin-bottom: 28px;
      letter-spacing: -2px;
    }
    
    .hero-title .gradient-text {
      background: linear-gradient(135deg, var(--accent-primary), var(--accent-tertiary), var(--accent-pink));
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
      position: relative;
    }
    
    .hero-subtitle {
      font-size: clamp(18px, 2vw, 24px);
      color: var(--text-secondary);
      max-width: 720px;
      margin: 0 auto 48px;
      line-height: 1.6;
      font-weight: 300;
    }
    
    .hero-actions {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 20px;
      flex-wrap: wrap;
    }
    
    .btn-primary {
      display: inline-flex;
      align-items: center;
      gap: 10px;
      padding: 18px 36px;
      background: linear-gradient(135deg, var(--accent-primary), var(--accent-secondary));
      color: var(--bg-deep);
      font-size: 16px;
      font-weight: 600;
      border: none;
      border-radius: 14px;
      cursor: pointer;
      transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
      text-decoration: none;
      position: relative;
      overflow: hidden;
    }
    
    .btn-primary::before {
      content: '';
      position: absolute;
      top: 0;
      left: -100%;
      width: 100%;
      height: 100%;
      background: linear-gradient(90deg, transparent, rgba(255,255,255,0.3), transparent);
      transition: left 0.6s ease;
    }
    
    .btn-primary:hover::before {
      left: 100%;
    }
    
    .btn-primary:hover {
      transform: translateY(-4px);
      box-shadow: 0 20px 40px rgba(0, 229, 255, 0.35);
    }
    
    .btn-secondary {
      display: inline-flex;
      align-items: center;
      gap: 10px;
      padding: 18px 36px;
      background: transparent;
      color: var(--text-primary);
      font-size: 16px;
      font-weight: 500;
      border: 1px solid var(--border-subtle);
      border-radius: 14px;
      cursor: pointer;
      transition: all 0.3s ease;
      text-decoration: none;
    }
    
    .btn-secondary:hover {
      border-color: var(--accent-primary);
      background: rgba(0, 229, 255, 0.05);
      color: var(--accent-primary);
    }
    
    /* Stats Bar */
    .stats-bar {
      display: flex;
      justify-content: center;
      gap: 60px;
      margin-top: 80px;
      padding: 40px;
      background: var(--bg-glass);
      backdrop-filter: blur(20px);
      border: 1px solid var(--border-subtle);
      border-radius: 24px;
      max-width: 900px;
      margin-left: auto;
      margin-right: auto;
    }
    
    .stat-item {
      text-align: center;
    }
    
    .stat-value {
      font-family: var(--font-tech);
      font-size: 36px;
      font-weight: 700;
      color: var(--accent-primary);
      margin-bottom: 8px;
    }
    
    .stat-label {
      font-size: 13px;
      color: var(--text-muted);
      text-transform: uppercase;
      letter-spacing: 1px;
    }
    
    /* Features Section */
    .features-section {
      padding: 100px 60px;
    }
    
    .section-header {
      text-align: center;
      margin-bottom: 64px;
    }
    
    .section-tag {
      font-family: var(--font-mono);
      font-size: 13px;
      color: var(--accent-primary);
      text-transform: uppercase;
      letter-spacing: 2px;
      margin-bottom: 16px;
    }
    
    .section-title {
      font-family: var(--font-heading);
      font-size: clamp(32px, 4vw, 52px);
      font-weight: 800;
      margin-bottom: 20px;
      letter-spacing: -1px;
    }
    
    .section-desc {
      font-size: 18px;
      color: var(--text-secondary);
      max-width: 600px;
      margin: 0 auto;
    }
    
    .features-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
      gap: 28px;
      max-width: 1200px;
      margin: 0 auto;
    }
    
    .feature-card {
      background: var(--bg-glass);
      backdrop-filter: blur(20px);
      border: 1px solid var(--border-subtle);
      border-radius: 24px;
      padding: 36px;
      transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
      position: relative;
      overflow: hidden;
    }
    
    .feature-card::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      height: 3px;
      background: linear-gradient(90deg, var(--accent-primary), var(--accent-tertiary));
      opacity: 0;
      transition: opacity 0.3s ease;
    }
    
    .feature-card:hover {
      transform: translateY(-8px);
      border-color: var(--accent-primary);
      box-shadow: 0 20px 60px rgba(0, 229, 255, 0.15);
    }
    
    .feature-card:hover::before {
      opacity: 1;
    }
    
    .feature-icon {
      width: 56px;
      height: 56px;
      border-radius: 16px;
      background: linear-gradient(135deg, rgba(0, 229, 255, 0.15), rgba(167, 139, 250, 0.15));
      display: flex;
      align-items: center;
      justify-content: center;
      margin-bottom: 24px;
    }
    
    .feature-icon .material-icons-round {
      font-size: 28px;
      color: var(--accent-primary);
    }
    
    .feature-title {
      font-size: 20px;
      font-weight: 700;
      margin-bottom: 12px;
    }
    
    .feature-desc {
      font-size: 15px;
      color: var(--text-secondary);
      line-height: 1.7;
    }
    
    /* Pipeline Section */
    .pipeline-section {
      padding: 100px 60px;
      background: var(--bg-glass-light);
      border-top: 1px solid var(--border-subtle);
      border-bottom: 1px solid var(--border-subtle);
    }
    
    .pipeline-visual {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 20px;
      margin-top: 60px;
      flex-wrap: wrap;
    }
    
    .pipeline-step {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 16px;
      padding: 28px 24px;
      background: var(--bg-glass);
      border: 1px solid var(--border-subtle);
      border-radius: 20px;
      min-width: 160px;
      transition: all 0.3s ease;
    }
    
    .pipeline-step:hover {
      border-color: var(--accent-primary);
      transform: translateY(-4px);
    }
    
    .pipeline-icon {
      width: 52px;
      height: 52px;
      border-radius: 14px;
      background: linear-gradient(135deg, var(--accent-primary), var(--accent-tertiary));
      display: flex;
      align-items: center;
      justify-content: center;
    }
    
    .pipeline-icon .material-icons-round {
      font-size: 26px;
      color: white;
    }
    
    .pipeline-label {
      font-size: 14px;
      font-weight: 600;
      text-align: center;
    }
    
    .pipeline-arrow {
      color: var(--accent-primary);
      font-size: 28px;
    }
    
    /* CTA Section */
    .cta-section {
      padding: 120px 60px;
      text-align: center;
    }
    
    .cta-box {
      max-width: 800px;
      margin: 0 auto;
      padding: 64px;
      background: linear-gradient(135deg, rgba(0, 229, 255, 0.08), rgba(167, 139, 250, 0.08));
      border: 1px solid var(--border-subtle);
      border-radius: 32px;
      position: relative;
      overflow: hidden;
    }
    
    .cta-box::before {
      content: '';
      position: absolute;
      top: -50%;
      left: -50%;
      width: 200%;
      height: 200%;
      background: conic-gradient(from 0deg, transparent, rgba(0, 229, 255, 0.1), transparent, rgba(167, 139, 250, 0.1), transparent);
      animation: ctaRotate 15s linear infinite;
    }
    
    @keyframes ctaRotate {
      0% { transform: rotate(0deg); }
      100% { transform: rotate(360deg); }
    }
    
    .cta-content {
      position: relative;
      z-index: 1;
    }
    
    .cta-title {
      font-family: var(--font-heading);
      font-size: 38px;
      font-weight: 800;
      margin-bottom: 20px;
    }
    
    .cta-desc {
      font-size: 18px;
      color: var(--text-secondary);
      margin-bottom: 36px;
    }
    
    .cta-buttons {
      display: flex;
      justify-content: center;
      gap: 16px;
      flex-wrap: wrap;
    }
    
    /* Footer */
    .footer {
      padding: 60px;
      border-top: 1px solid var(--border-subtle);
      background: var(--bg-glass);
    }
    
    .footer-content {
      display: grid;
      grid-template-columns: 2fr repeat(3, 1fr);
      gap: 48px;
      max-width: 1200px;
      margin: 0 auto;
    }
    
    .footer-brand {
      display: flex;
      flex-direction: column;
      gap: 20px;
    }
    
    .footer-logo {
      display: flex;
      align-items: center;
      gap: 12px;
    }
    
    .footer-logo-icon {
      width: 40px;
      height: 40px;
      background: linear-gradient(135deg, var(--accent-primary), var(--accent-tertiary));
      border-radius: 10px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-family: var(--font-tech);
      font-weight: 900;
      font-size: 14px;
      color: var(--bg-deep);
    }
    
    .footer-logo-text {
      font-family: var(--font-heading);
      font-size: 20px;
      font-weight: 700;
    }
    
    .footer-desc {
      font-size: 14px;
      color: var(--text-muted);
      line-height: 1.7;
    }
    
    .footer-column h4 {
      font-size: 14px;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 1px;
      margin-bottom: 20px;
      color: var(--text-primary);
    }
    
    .footer-links {
      display: flex;
      flex-direction: column;
      gap: 12px;
    }
    
    .footer-links a {
      color: var(--text-muted);
      text-decoration: none;
      font-size: 14px;
      transition: color 0.2s ease;
    }
    
    .footer-links a:hover {
      color: var(--accent-primary);
    }
    
    .footer-bottom {
      margin-top: 48px;
      padding-top: 24px;
      border-top: 1px solid var(--border-subtle);
      display: flex;
      justify-content: space-between;
      align-items: center;
      font-size: 13px;
      color: var(--text-muted);
    }
    
    .footer-social {
      display: flex;
      gap: 16px;
    }
    
    .footer-social a {
      color: var(--text-muted);
      transition: color 0.2s ease;
    }
    
    .footer-social a:hover {
      color: var(--accent-primary);
    }
    
    /* Modal Styles */
    .modal-overlay {
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      background: rgba(0, 0, 0, 0.7);
      backdrop-filter: blur(8px);
      z-index: 1000;
      display: flex;
      align-items: center;
      justify-content: center;
      opacity: 0;
      visibility: hidden;
      transition: all 0.3s ease;
    }
    
    .modal-overlay.show {
      opacity: 1;
      visibility: visible;
    }
    
    .modal-box {
      background: var(--bg-glass);
      backdrop-filter: blur(24px);
      border: 1px solid var(--border-subtle);
      border-radius: 28px;
      padding: 48px;
      max-width: 520px;
      width: 90%;
      transform: scale(0.95) translateY(20px);
      transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    }
    
    .modal-overlay.show .modal-box {
      transform: scale(1) translateY(0);
    }
    
    .modal-header {
      text-align: center;
      margin-bottom: 36px;
    }
    
    .modal-title {
      font-family: var(--font-heading);
      font-size: 28px;
      font-weight: 800;
      margin-bottom: 12px;
    }
    
    .modal-subtitle {
      color: var(--text-secondary);
      font-size: 15px;
    }
    
    .quick-options {
      display: flex;
      flex-direction: column;
      gap: 14px;
      margin-bottom: 32px;
    }
    
    .quick-option {
      display: flex;
      align-items: center;
      gap: 16px;
      padding: 18px 20px;
      background: var(--bg-glass-light);
      border: 1px solid var(--border-subtle);
      border-radius: 14px;
      cursor: pointer;
      transition: all 0.3s ease;
    }
    
    .quick-option:hover {
      border-color: var(--accent-primary);
      background: rgba(0, 229, 255, 0.05);
    }
    
    .quick-option input[type="checkbox"] {
      appearance: none;
      -webkit-appearance: none;
      width: 24px;
      height: 24px;
      border: 2px solid var(--border-subtle);
      border-radius: 6px;
      cursor: pointer;
      position: relative;
      transition: all 0.2s ease;
    }
    
    .quick-option input[type="checkbox"]:checked {
      background: var(--accent-primary);
      border-color: var(--accent-primary);
    }
    
    .quick-option input[type="checkbox"]:checked::after {
      content: '✓';
      position: absolute;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      color: var(--bg-deep);
      font-size: 14px;
      font-weight: bold;
    }
    
    .option-content strong {
      display: block;
      font-size: 15px;
      font-weight: 600;
      margin-bottom: 4px;
    }
    
    .option-content small {
      font-size: 13px;
      color: var(--text-muted);
    }
    
    .btn-submit {
      width: 100%;
      padding: 18px;
      background: linear-gradient(135deg, var(--accent-primary), var(--accent-tertiary));
      color: var(--bg-deep);
      font-size: 16px;
      font-weight: 600;
      border: none;
      border-radius: 14px;
      cursor: pointer;
      transition: all 0.3s ease;
    }
    
    .btn-submit:hover {
      transform: translateY(-2px);
      box-shadow: 0 10px 30px rgba(0, 229, 255, 0.3);
    }
    
    /* Responsive */
    @media (max-width: 1024px) {
      :root {
        --sidebar-width: 60px;
      }
      
      .molecular-sidebar {
        width: 60px;
      }
      
      .dna-helix {
        width: 40px;
      }
      
      .nucleotide {
        width: 8px;
        height: 8px;
      }
      
      .nav-container {
        padding: 0 20px;
      }
      
      .nav-links {
        display: none;
      }
      
      .main-content {
        padding-left: 20px;
        padding-right: 20px;
      }
      
      .hero-section,
      .features-section,
      .pipeline-section,
      .cta-section {
        padding-left: 30px;
        padding-right: 30px;
      }
      
      .stats-bar {
        gap: 30px;
        flex-wrap: wrap;
      }
      
      .footer-content {
        grid-template-columns: 1fr 1fr;
      }
    }
    
    @media (max-width: 768px) {
      :root {
        --sidebar-width: 0px;
        --nav-height: 70px;
      }
      
      .molecular-sidebar {
        display: none;
      }
      
      .neural-bg {
        width: 100%;
        margin-left: 0;
      }
      
      .main-content {
        margin-left: 0;
        margin-right: 0;
      }
      
      .nav-container {
        left: 0;
        right: 0;
        padding: 0 16px;
      }
      
      .page-nav-bar {
        display: none;
      }
      
      .hero-title {
        font-size: 36px;
        letter-spacing: -1px;
      }
      
      .features-grid {
        grid-template-columns: 1fr;
      }
      
      .pipeline-visual {
        flex-direction: column;
      }
      
      .pipeline-arrow {
        transform: rotate(90deg);
      }
      
      .footer-content {
        grid-template-columns: 1fr;
        gap: 32px;
      }
      
      .footer-bottom {
        flex-direction: column;
        gap: 16px;
        text-align: center;
      }
      
      .cta-box {
        padding: 36px 24px;
      }
      
      .cta-title {
        font-size: 26px;
      }
    }
  </style>
</head>
<body>
  <!-- Left Molecular Sidebar (DNA/RNA Visualization) -->
  <aside class="molecular-sidebar left">
    <div class="molecular-grid"></div>
    <div class="dna-helix">
      <div class="backbone-line"></div>
      <div class="dna-strand" id="leftDnaStrand"></div>
    </div>
    <div class="protein-chain" id="leftProteinChain"></div>
    <!-- Floating molecules -->
    <div class="floating-molecule" style="width: 20px; height: 20px; top: 15%; left: 30%;"></div>
    <div class="floating-molecule" style="width: 14px; height: 14px; top: 45%; left: 55%;"></div>
    <div class="floating-molecule" style="width: 18px; height: 18px; top: 75%; left: 25%;"></div>
  </aside>

  <!-- Right Molecular Sidebar (Protein/Macromolecule Visualization) -->
  <aside class="molecular-sidebar right">
    <div class="molecular-grid"></div>
    <div class="dna-helix">
      <div class="backbone-line"></div>
      <div class="dna-strand" id="rightDnaStrand"></div>
    </div>
    <div class="protein-chain" id="rightProteinChain"></div>
    <!-- Floating molecules -->
    <div class="floating-molecule" style="width: 16px; height: 16px; top: 25%; left: 40%;"></div>
    <div class="floating-molecule" style="width: 22px; height: 22px; top: 55%; left: 60%;"></div>
    <div class="floating-molecule" style="width: 12px; height: 12px; top: 85%; left: 35%;"></div>
  </aside>

  <!-- Neural Network Background -->
  <div class="neural-bg" id="neuralBg"></div>

  <!-- Navigation System -->
  <nav class="nav-container">
    <a href="index.html" class="nav-brand">
      <div class="nav-logo">S</div>
      <span class="nav-title">Sci<span>MSPT</span></span>
    </a>
    
    <div class="nav-links">
      <a href="index.html" class="nav-link active">
        <span class="material-icons-round">home</span>
        Home
      </a>
      <a href="research.html" class="nav-link">
        <span class="material-icons-round">biotech</span>
        Research
      </a>
      <a href="startups.html" class="nav-link">
        <span class="material-icons-round">rocket_launch</span>
        Startups
      </a>
      <a href="platform.html" class="nav-link">
        <span class="material-icons-round">dashboard</span>
        Platform
      </a>
      <a href="documentation.html" class="nav-link">
        <span class="material-icons-round">code</span>
        API Docs
      </a>
      <a href="about.html" class="nav-link">
        <span class="material-icons-round">info</span>
        About
      </a>
    </div>
    
    <div style="display: flex; align-items: center; gap: 16px;">
      <button class="theme-toggle" onclick="toggleTheme()" title="Toggle theme">
        <span class="material-icons-round" id="themeIcon">dark_mode</span>
      </button>
      
      <button class="workspace-btn" onclick="openWorkspace()">
        <span class="material-icons-round">workspaces</span>
        Workspace
      </button>
      
      <div class="user-dropdown">
        <div class="user-profile" onclick="toggleUserDropdown()">
          <div class="user-avatar">AE</div>
          <div class="user-info">
            <span class="user-name">Dr. Elena Vasquez</span>
            <span class="user-role">Neural Architect</span>
          </div>
        </div>
        
        <div class="dropdown-menu" id="userDropdown">
          <div class="dropdown-header">
            <div class="dropdown-user-name">Dr. Elena Vasquez</div>
            <div class="dropdown-user-email">elena.vasquez@scimspt.io</div>
          </div>
          <a href="#" class="dropdown-item">
            <span class="material-icons-round">person</span>
            My Profile
          </a>
          <a href="dashboard.html" class="dropdown-item">
            <span class="material-icons-round">space_dashboard</span>
            Dashboard
          </a>
          <a href="platform.html#collaboration" class="dropdown-item">
            <span class="material-icons-round">groups</span>
            My Workspaces
          </a>
          <a href="#" class="dropdown-item">
            <span class="material-icons-round">settings</span>
            Settings
          </a>
          <div class="dropdown-divider"></div>
          <a href="#" class="dropdown-item" onclick="handleLogout()">
            <span class="material-icons-round">logout</span>
            Sign Out
          </a>
        </div>
      </div>
    </div>
  </nav>

  <!-- Page Navigation Bar (Return / Home) -->
  <div class="page-nav-bar">
    <a href="javascript:history.back()" class="page-nav-btn">
      <span class="material-icons-round">arrow_back</span>
      Back
    </a>
    <span class="page-indicator">|</span>
    <a href="index.html" class="page-nav-btn">
      <span class="material-icons-round">home</span>
      Home
    </a>
    <span class="page-indicator">|</span>
    <a href="platform.html" class="page-nav-btn">
      <span class="material-icons-round">apps</span>
      Platform
    </a>
  </div>

  <!-- Main Content -->
  <main class="main-content">
    <!-- Hero Section -->
    <section class="hero-section">
      <div class="hero-badge">
        <span class="pulse-dot"></span>
        Neural Intelligence Platform v3.0 — Live
      </div>
      
      <h1 class="hero-title">
        Where <span class="gradient-text">Molecular Intelligence</span><br>
        Meets Investment Foresight
      </h1>
      
      <p class="hero-subtitle">
        Transform peer-reviewed scientific research into validated frontier technology 
        opportunities through our AI-powered neural analysis engine.
      </p>
      
      <div class="hero-actions">
        <a href="#get-started" class="btn-primary" onclick="openGetStartedModal()">
          <span class="material-icons-round">rocket_launch</span>
          Get Started Free
        </a>
        <a href="platform.html" class="btn-secondary">
          <span class="material-icons-round">explore</span>
          Explore Platform
        </a>
        <a href="documentation.html" class="btn-secondary">
          <span class="material-icons-round">code</span>
          Get API Access
        </a>
      </div>
      
      <div class="stats-bar">
        <div class="stat-item">
          <div class="stat-value">2.4M+</div>
          <div class="stat-label">Papers Analyzed</div>
        </div>
        <div class="stat-item">
          <div class="stat-value">847</div>
          <div class="stat-label">Startups Validated</div>
        </div>
        <div class="stat-item">
          <div class="stat-value">99.2%</div>
          <div class="stat-label">Prediction Accuracy</div>
        </div>
        <div class="stat-item">
          <div class="stat-value">12K+</div>
          <div class="stat-label">Active Researchers</div>
        </div>
      </div>
    </section>

    <!-- Features Section -->
    <section class="features-section">
      <div class="section-header">
        <p class="section-tag">// Capabilities</p>
        <h2 class="section-title">Neural-Powered Analysis Engine</h2>
        <p class="section-desc">
          Our proprietary molecular computing architecture processes research papers 
          through multiple neural layers for unprecedented insight extraction.
        </p>
      </div>
      
      <div class="features-grid">
        <article class="feature-card">
          <div class="feature-icon">
            <span class="material-icons-round">psychology</span>
          </div>
          <h3 class="feature-title">Cognitive Paper Analysis</h3>
          <p class="feature-desc">
            Multi-modal understanding of research papers including semantic extraction, 
            methodology validation, and cross-domain correlation mapping using transformer 
            architectures fine-tuned on 50M+ scientific documents.
          </p>
        </article>
        
        <article class="feature-card">
          <div class="feature-icon">
            <span class="material-icons-round">hub</span>
          </div>
          <h3 class="feature-title">Knowledge Graph Synthesis</h3>
          <p class="feature-desc">
            Dynamic construction of interconnected knowledge networks linking researchers, 
            institutions, funding sources, and citation patterns to reveal hidden 
            collaboration opportunities and emerging research clusters.
          </p>
        </article>
        
        <article class="feature-card">
          <div class="feature-icon">
            <span class="material-icons-round">trending_up</span>
          </div>
          <h3 class="feature-title">Venture Signal Detection</h3>
          <p class="feature-desc">
            Proprietary algorithms identify investable signals from academic breakthroughs 
            by analyzing team composition, IP landscape, market timing, and 
            commercialization readiness scores.
          </p>
        </article>
        
        <article class="feature-card">
          <div class="feature-icon">
            <span class="material-icons-round">auto_awesome</span>
          </div>
          <h3 class="feature-title">Generative Insights</h3>
          <p class="feature-desc">
            LLM-powered synthesis that transforms complex research findings into 
            actionable executive summaries, market analyses, and investment theses 
            tailored to your specific focus areas.
          </p>
        </article>
        
        <article class="feature-card">
          <div class="feature-icon">
            <span class="material-icons-round">storage</span>
          </div>
          <h3 class="feature-title">Quantum-Ready Infrastructure</h3>
          <p class="feature-desc">
            Built on distributed computing architecture optimized for quantum-classical 
            hybrid workloads, enabling exponential speedup in pattern recognition 
            and optimization tasks.
          </p>
        </article>
        
        <article class="feature-card">
          <div class="feature-icon">
            <span class="material-icons-round">shield</span>
          </div>
          <h3 class="feature-title">Zero-Knowledge Proofs</h3>
          <p class="feature-desc">
            Privacy-preserving computation ensures your research interests and 
            portfolio strategies remain confidential while benefiting from 
            collective intelligence aggregation.
          </p>
        </article>
      </div>
    </section>

    <!-- Pipeline Section -->
    <section class="pipeline-section">
      <div class="section-header">
        <p class="section-tag">// Process Flow</p>
        <h2 class="section-title">Research-to-Revenue Pipeline</h2>
        <p class="section-desc">
          Our automated pipeline transforms raw academic output into 
          structured investment-ready intelligence in under 24 hours.
        </p>
      </div>
      
      <div class="pipeline-visual">
        <div class="pipeline-step">
          <div class="pipeline-icon">
            <span class="material-icons-round">description</span>
          </div>
          <span class="pipeline-label">Paper Ingestion</span>
        </div>
        
        <span class="material-icons-round pipeline-arrow">arrow_forward</span>
        
        <div class="pipeline-step">
          <div class="pipeline-icon">
            <span class="material-icons-round">psychology</span>
          </div>
          <span class="pipeline-label">Neural Analysis</span>
        </div>
        
        <span class="material-icons-round pipeline-arrow">arrow_forward</span>
        
        <div class="pipeline-step">
          <div class="pipeline-icon">
            <span class="material-icons-round">analytics</span>
          </div>
          <span class="pipeline-label">Signal Extraction</span>
        </div>
        
        <span class="material-icons-round pipeline-arrow">arrow_forward</span>
        
        <div class="pipeline-step">
          <div class="pipeline-icon">
            <span class="material-icons-round">rocket_launch</span>
          </div>
          <span class="pipeline-label">Startup Match</span>
        </div>
        
        <span class="material-icons-round pipeline-arrow">arrow_forward</span>
        
        <div class="pipeline-step">
          <div class="pipeline-icon">
            <span class="material-icons-round">attach_money</span>
          </div>
          <span class="pipeline-label">Investment Ready</span>
        </div>
      </div>
    </section>

    <!-- CTA Section -->
    <section class="cta-section" id="get-started">
      <div class="cta-box">
