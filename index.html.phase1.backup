  <!-- Get Started Modal -->
  <div class="modal-overlay" id="getStartedModal">
    <div class="modal-box">
      <div class="modal-header">
        <h3 class="modal-title">Configure Your Access</h3>
        <p class="modal-subtitle">Select your research interests to personalize your experience</p>
      </div>
      
      <div class="quick-options">
        <label class="quick-option">
          <input type="checkbox" name="research_access" checked>
          <span class="option-content">
            <strong>Research Tools</strong>
            <small>Paper analysis & trend detection</small>
          </span>
        </label>
        
        <label class="quick-option">
          <input type="checkbox" name="startup_data" checked>
          <span class="option-content">
            <strong>Startup Intelligence</strong>
            <small>Weekly validated startup reports</small>
          </span>
        </label>
        
        <label class="quick-option">
          <input type="checkbox" name="api_access">
          <span class="option-content">
            <strong>API Integration</strong>
            <small>Programmatic access to all features</small>
          </span>
        </label>
        
        <label class="quick-option">
          <input type="checkbox" name="notifications" checked>
          <span class="option-content">
            <strong>Smart Notifications</strong>
            <small>Real-time alerts on breakthrough papers</small>
          </span>
        </label>
        
        <label class="quick-option">
          <input type="checkbox" name="collaboration">
          <span class="option-content">
            <strong>Collaborative Workspace</strong>
            <small>Team research & shared pipelines</small>
          </span>
        </label>
      </div>
      
      <button class="btn-submit" onclick="quickAccess()">Get Instant Access</button>
    </div>
  </div>

  <script>
    // ============================================
    // SCIMSPT NEURAL INTERFACE CONTROLLERS
    // ============================================
    
    // Synthetic user data (creative personas)
    const userData = {
      current: {
        name: 'Dr. Elena Vasquez',
        initials: 'EV',
        email: 'elena.vasquez@scimspt.io',
        role: 'Neural Architect',
        avatar: '#00E5FF',
        status: 'online',
        joinDate: '2024-03-15',
        researchCount: 1247,
        startupsTracked: 89
      },
      personas: [
        {
          name: 'Dr. Elena Vasquez',
          initials: 'EV',
          email: 'elena.vasquez@scimspt.io',
          role: 'Neural Architect',
          specialization: 'Computational Biology & ML'
        },
        {
          name: 'Marcus Chen',
          initials: 'MC',
          email: 'marcus.chen@scimspt.io',
          role: 'Quantum Analyst',
          specialization: 'Quantum Computing & Finance'
        },
        {
          name: 'Dr. Aisha Patel',
          initials: 'AP',
          email: 'aisha.patel@scimspt.io',
          role: 'Bioinformatics Lead',
          specialization: 'Genomics & Drug Discovery'
        }
      ]
    };
    
    // Initialize DNA Helix Visualizations
    function initDnaHelix() {
      const strands = [
        { container: 'leftDnaStrand', offset: 0 },
        { container: 'rightDnaStrand', offset: 50 }
      ];
      
      const nucleotides = ['adenine', 'thymine', 'guanine', 'cytosine'];
      const positions = [];
      
      strands.forEach(({ container, offset }) => {
        const strand = document.getElementById(container);
        if (!strand) return;
        
        for (let i = 0; i < 20; i++) {
          const nucleotide = document.createElement('div');
          nucleotide.className = `nucleotide ${nucleotides[i % 4]}`;
          
          const y = (i / 20) * 100;
          const x = 50 + Math.sin((i + offset) * 0.5) * 35;
          const delay = (i * 0.15) % 3;
          
          nucleotide.style.cssText = `
            top: ${y}%;
            left: ${x}%;
            transform: translate(-50%, -50%);
            animation-delay: ${delay}s;
          `;
          
          strand.appendChild(nucleotide);
        }
      });
    }
    
    // Initialize Protein Chains
    function initProteinChains() {
      const chains = ['leftProteinChain', 'rightProteinChain'];
      
      chains.forEach(chainId => {
        const chain = document.getElementById(chainId);
        if (!chain) return;
        
        for (let i = 0; i < 12; i++) {
          const amino = document.createElement('div');
          amino.className = 'amino-acid';
          
          const y = (i / 12) * 100;
          const x = Math.sin(i * 0.8) * 15;
          const delay = (i * 0.3) % 4;
          const hue = (i * 30) % 360;
          
          amino.style.cssText = `
            top: ${y}%;
            left: calc(50% + ${x}px);
            transform: translate(-50%, -50%);
            animation-delay: ${delay}s;
            background: hsl(${hue}, 70%, 60%);
          `;
          
          chain.appendChild(amino);
        }
      });
    }
    
    // Initialize Neural Background
    function initNeuralBackground() {
      const bg = document.getElementById('neuralBg');
      if (!bg) return;
      
      // Create neurons
      for (let i = 0; i < 50; i++) {
        const neuron = document.createElement('div');
        neuron.className = 'neuron';
        neuron.style.cssText = `
          left: ${Math.random() * 100}%;
          top: ${Math.random() * 100}%;
          animation-delay: ${Math.random() * 4}s;
        `;
        bg.appendChild(neuron);
      }
      
      // Create synapses
      for (let i = 0; i < 30; i++) {
        const synapse = document.createElement('div');
        synapse.className = 'synapse';
        synapse.style.cssText = `
          left: ${Math.random() * 100}%;
          top: ${Math.random() * 100}%;
          width: ${50 + Math.random() * 150}px;
          animation-delay: ${Math.random() * 3}s;
        `;
        bg.appendChild(synapse);
      }
    }
    
    // Theme Toggle
    function toggleTheme() {
      const html = document.documentElement;
      const icon = document.getElementById('themeIcon');
      const isDark = html.getAttribute('data-theme') === 'dark';
      
      html.setAttribute('data-theme', isDark ? 'light' : 'dark');
      icon.textContent = isDark ? 'light_mode' : 'dark_mode';
      localStorage.setItem('theme', isDark ? 'light' : 'dark');
    }
    
    // Load saved theme
    function loadTheme() {
      const saved = localStorage.getItem('theme');
      if (saved) {
        document.documentElement.setAttribute('data-theme', saved);
        document.getElementById('themeIcon').textContent = 
          saved === 'dark' ? 'dark_mode' : 'light_mode';
      }
    }
    
    // User Dropdown
    function toggleUserDropdown() {
      const dropdown = document.getElementById('userDropdown');
      dropdown.classList.toggle('show');
    }
    
    // Close dropdown when clicking outside
    document.addEventListener('click', (e) => {
      const dropdown = document.getElementById('userDropdown');
      const profile = document.querySelector('.user-profile');
      if (!profile.contains(e.target)) {
        dropdown.classList.remove('show');
      }
    });
    
    // Workspace Modal
    function openWorkspace() {
      window.location.href = 'platform.html#collaboration';
    }
    
    // Get Started Modal
    function openGetStartedModal() {
      document.getElementById('getStartedModal').classList.add('show');
    }
    
    function closeGetStartedModal() {
      document.getElementById('getStartedModal').classList.remove('show');
    }
    
    // Quick Access Handler
    function quickAccess() {
      const options = document.querySelectorAll('.quick-option input[type="checkbox"]');
      const selected = [];
      
      options.forEach(opt => {
        if (opt.checked) selected.push(opt.name);
      });
      
      // Simulate processing
      const btn = document.querySelector('.btn-submit');
      btn.innerHTML = '<span class="material-icons-round">progress_activity</span> Initializing...';
      btn.disabled = true;
      
      setTimeout(() => {
        closeGetStartedModal();
        
        // Show success notification
        showNotification(`Welcome, ${userData.current.name}! Your neural workspace is ready.`);
        
        // Reset button
        btn.innerHTML = 'Get Instant Access';
        btn.disabled = false;
        
        // Store preferences
        localStorage.setItem('userPreferences', JSON.stringify(selected));
      }, 1500);
    }
    
    // Notification System
    function showNotification(message) {
      const notification = document.createElement('div');
      notification.style.cssText = `
        position: fixed;
        bottom: 30px;
        right: 30px;
        padding: 20px 28px;
        background: linear-gradient(135deg, var(--accent-primary), var(--accent-tertiary));
        color: var(--bg-deep);
        border-radius: 14px;
        font-weight: 600;
        z-index: 9999;
        animation: slideIn 0.4s ease;
        box-shadow: 0 10px 40px rgba(0, 229, 255, 0.3);
      `;
      notification.textContent = message;
      document.body.appendChild(notification);
      
      setTimeout(() => {
        notification.style.animation = 'slideOut 0.3s ease forwards';
        setTimeout(() => notification.remove(), 300);
      }, 4000);
    }
    
    // Logout Handler
    function handleLogout() {
      localStorage.removeItem('userPreferences');
      showNotification('Signed out successfully. See you soon!');
      setTimeout(() => {
        location.reload();
      }, 1500);
    }
    
    // Close modal on overlay click
    document.getElementById('getStartedModal').addEventListener('click', (e) => {
      if (e.target.id === 'getStartedModal') {
        closeGetStartedModal();
      }
    });
    
    // Keyboard shortcuts
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        closeGetStartedModal();
        document.getElementById('userDropdown').classList.remove('show');
      }
      if ((e.metaKey || e.ctrlKey) && e.key === 'k') {
        e.preventDefault();
        openGetStartedModal();
      }
    });
    
    // Add CSS animations dynamically
    const style = document.createElement('style');
    style.textContent = `
      @keyframes slideIn {
        from { transform: translateX(100px); opacity: 0; }
        to { transform: translateX(0); opacity: 1; }
      }
      @keyframes slideOut {
        from { transform: translateX(0); opacity: 1; }
        to { transform: translateX(100px); opacity: 0; }
      }
    `;
    document.head.appendChild(style);
    
    // Initialize everything
    document.addEventListener('DOMContentLoaded', () => {
      loadTheme();
      initDnaHelix();
      initProteinChains();
      initNeuralBackground();
    });
  </script>
</body>
</html>