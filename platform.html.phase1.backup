<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Platform Features — SciMSPT Neural Command Center</title>
  <meta name="description" content="SciMSPT Platform: AI API Integration, Cloud Storage Sync, Collaborative Workspaces, Analysis Pipelines, and Model Fine-Tuning capabilities.">
  
  <!-- Fonts -->
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;700;900&family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500;600&family=Orbitron:wght@400;700;900&display=swap" rel="stylesheet">
  <link href="https://fonts.googleapis.com/icon?family=Material+Icons+Round" rel="stylesheet">
  
  <style>
    /* ============================================
       SCIMSPT NEURAL DESIGN SYSTEM v3.0
       Platform Command Center
       ============================================ */
    
    :root {
      --bg-deep: #030810;
      --bg-primary: #0a1628;
      --bg-secondary: #0d1f35;
      --bg-tertiary: #122a45;
      --bg-glass: rgba(10, 22, 40, 0.85);
      --bg-glass-light: rgba(255, 255, 255, 0.03);
      
      --accent-primary: #00E5FF;
      --accent-secondary: #4da8da;
      --accent-tertiary: #a78bfa;
      --accent-pink: #f472b6;
      --accent-green: #10b981;
      --accent-gold: #f59e0b;
      
      --text-primary: #e8f4fc;
      --text-secondary: #94a3b8;
      --text-muted: #64748b;
      
      --border-subtle: rgba(0, 229, 255, 0.15);
      --border-glow: rgba(0, 229, 255, 0.4);
      
      --font-heading: 'Playfair Display', Georgia, serif;
      --font-body: 'Inter', -apple-system, sans-serif;
      --font-mono: 'JetBrains Mono', monospace;
      --font-tech: 'Orbitron', sans-serif;
      
      --nav-height: 80px;
      --sidebar-width: 100px;
      
      --glow-primary: 0 0 30px rgba(0, 229, 255, 0.3);
      --glow-secondary: 0 0 60px rgba(167, 139, 250, 0.2);
      
      --success: #10b981;
      --warning: #f59e0b;
      --error: #ef4444;
      --research: #00E5FF;
      --purple: #a78bfa;
      --pink: #f472b6;
    }
    
    [data-theme="light"] {
      --bg-deep: #f0f4f8;
      --bg-primary: #ffffff;
      --bg-secondary: #f8fafc;
      --bg-tertiary: #e2e8f0;
      --bg-glass: rgba(255, 255, 255, 0.92);
      --bg-glass-light: rgba(0, 0, 0, 0.02);
      --text-primary: #0f172a;
      --text-secondary: #475569;
      --text-muted: #94a3b8;
      --border-subtle: rgba(77, 168, 218, 0.25);
    }
    
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }
    
    html {
      scroll-behavior: smooth;
    }
    
    body {
      font-family: var(--font-body);
      background: var(--bg-deep);
      color: var(--text-primary);
      line-height: 1.6;
      overflow-x: hidden;
      min-height: 100vh;
    }
    
    /* ============================================
       MOLECULAR SIDE BARS - DNA/RNA VISUALIZATION
       ============================================ */
    
    .molecular-sidebar {
      position: fixed;
      top: 0;
      width: var(--sidebar-width);
      height: 100vh;
      z-index: 5;
      pointer-events: none;
      overflow: hidden;
    }
    
    .molecular-sidebar.left {
      left: 0;
      background: linear-gradient(
        90deg,
        rgba(0, 229, 255, 0.08) 0%,
        transparent 100%
      );
      border-right: 1px solid var(--border-subtle);
    }
    
    .molecular-sidebar.right {
      right: 0;
      background: linear-gradient(
        -90deg,
        rgba(167, 139, 250, 0.08) 0%,
        transparent 100%
      );
      border-left: 1px solid var(--border-subtle);
    }
    
    .dna-helix {
      position: absolute;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      width: 60px;
      height: 80vh;
    }
    
    .nucleotide {
      position: absolute;
      width: 12px;
      height: 12px;
      border-radius: 50%;
      animation: nucleotidePulse 3s ease-in-out infinite;
    }
    
    .nucleotide.adenine { background: var(--accent-primary); box-shadow: 0 0 10px var(--accent-primary); }
    .nucleotide.thymine { background: var(--accent-pink); box-shadow: 0 0 10px var(--accent-pink); }
    .nucleotide.guanine { background: var(--accent-tertiary); box-shadow: 0 0 10px var(--accent-tertiary); }
    .nucleotide.cytosine { background: var(--accent-green); box-shadow: 0 0 10px var(--accent-green); }
    
    @keyframes nucleotidePulse {
      0%, 100% { opacity: 0.6; transform: scale(1); }
      50% { opacity: 1; transform: scale(1.2); }
    }
    
    .backbone-line {
      position: absolute;
      width: 2px;
      height: 100%;
      left: 50%;
      background: linear-gradient(
        to bottom,
        transparent,
        var(--accent-primary) 20%,
        var(--accent-tertiary) 50%,
        var(--accent-pink) 80%,
        transparent
      );
      opacity: 0.3;
    }
    
    .protein-chain {
      position: absolute;
      width: 40px;
      height: 200px;
      top: 20%;
    }
    
    .amino-acid {
      position: absolute;
      width: 8px;
      height: 8px;
      border-radius: 2px;
      background: var(--accent-gold);
      opacity: 0.7;
      animation: aminoFloat 4s ease-in-out infinite;
    }
    
    @keyframes aminoFloat {
      0%, 100% { transform: translateX(0) rotate(0deg); }
      50% { transform: translateX(10px) rotate(180deg); }
    }
    
    .molecular-grid {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background-image: 
        radial-gradient(circle at 20% 30%, rgba(0, 229, 255, 0.05) 1px, transparent 1px),
        radial-gradient(circle at 70% 60%, rgba(167, 139, 250, 0.05) 1px, transparent 1px),
        radial-gradient(circle at 40% 80%, rgba(244, 114, 182, 0.05) 1px, transparent 1px);
      background-size: 30px 30px, 50px 50px, 40px 40px;
      animation: gridShift 20s linear infinite;
    }
    
    @keyframes gridShift {
      0% { transform: translateY(0); }
      100% { transform: translateY(30px); }
    }
    
    .floating-molecule {
      position: absolute;
      border: 1px solid var(--border-subtle);
      border-radius: 50%;
      animation: moleculeFloat 8s ease-in-out infinite;
    }
    
    .floating-molecule::before {
      content: '';
      position: absolute;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      width: 4px;
      height: 4px;
      background: var(--accent-primary);
      border-radius: 50%;
    }
    
    @keyframes moleculeFloat {
      0%, 100% { transform: translateY(0) rotate(0deg); opacity: 0.5; }
      50% { transform: translateY(-30px) rotate(180deg); opacity: 0.8; }
    }
    
    /* Neural Background */
    .neural-bg {
      position: fixed;
      top: 0;
      left: calc(var(--sidebar-width));
      width: calc(100% - 2 * var(--sidebar-width));
      height: 100%;
      z-index: 0;
      overflow: hidden;
    }
    
    .neuron {
      position: absolute;
      width: 4px;
      height: 4px;
      background: var(--accent-primary);
      border-radius: 50%;
      opacity: 0.4;
      animation: neuronPulse 4s ease-in-out infinite;
    }
    
    .synapse {
      position: absolute;
      height: 1px;
      background: linear-gradient(90deg, transparent, var(--accent-primary), transparent);
      opacity: 0.2;
      animation: synapseFire 3s ease-in-out infinite;
    }
    
    @keyframes neuronPulse {
      0%, 100% { opacity: 0.2; transform: scale(1); }
      50% { opacity: 0.6; transform: scale(1.5); }
    }
    
    @keyframes synapseFire {
      0%, 100% { opacity: 0.1; }
      50% { opacity: 0.4; }
    }
    
    /* Navigation */
    .nav-container {
      position: fixed;
      top: 0;
      left: var(--sidebar-width);
      right: var(--sidebar-width);
      height: var(--nav-height);
      z-index: 100;
      background: var(--bg-glass);
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
      border-bottom: 1px solid var(--border-subtle);
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0 40px;
    }
    
    .nav-brand {
      display: flex;
      align-items: center;
      gap: 12px;
      text-decoration: none;
      color: var(--text-primary);
    }
    
    .nav-logo {
      width: 42px;
      height: 42px;
      background: linear-gradient(135deg, var(--accent-primary), var(--accent-tertiary));
      border-radius: 12px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-family: var(--font-tech);
      font-weight: 900;
      font-size: 16px;
      color: var(--bg-deep);
      position: relative;
      overflow: hidden;
    }
    
    .nav-logo::before {
      content: '';
      position: absolute;
      top: -50%;
      left: -50%;
      width: 200%;
      height: 200%;
      background: conic-gradient(from 0deg, transparent, rgba(255,255,255,0.3), transparent);
      animation: logoShine 4s linear infinite;
    }
    
    @keyframes logoShine {
      0% { transform: rotate(0deg); }
      100% { transform: rotate(360deg); }
    }
    
    .nav-title {
      font-family: var(--font-heading);
      font-size: 22px;
      font-weight: 700;
      letter-spacing: -0.5px;
    }
    
    .nav-title span {
      color: var(--accent-primary);
    }
    
    .nav-links {
      display: flex;
      align-items: center;
      gap: 8px;
    }
    
    .nav-link {
      display: flex;
      align-items: center;
      gap: 6px;
      padding: 10px 18px;
      text-decoration: none;
      color: var(--text-secondary);
      font-size: 14px;
      font-weight: 500;
      border-radius: 10px;
      transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
      position: relative;
      overflow: hidden;
    }
    
    .nav-link::before {
      content: '';
      position: absolute;
      bottom: 0;
      left: 50%;
      transform: translateX(-50%);
      width: 0;
      height: 2px;
      background: var(--accent-primary);
      transition: width 0.3s ease;
    }
    
    .nav-link:hover {
      color: var(--text-primary);
      background: var(--bg-glass-light);
    }
    
    .nav-link:hover::before {
      width: 60%;
    }
    
    .nav-link.active {
      color: var(--accent-primary);
      background: rgba(0, 229, 255, 0.08);
    }
    
    .nav-link.active::before {
      width: 60%;
    }
    
    .nav-link .material-icons-round {
      font-size: 18px;
    }
    
    .workspace-btn {
      display: flex;
      align-items: center;
      gap: 8px;
      padding: 12px 24px;
      background: linear-gradient(135deg, var(--accent-primary), var(--accent-tertiary));
      color: var(--bg-deep);
      font-weight: 600;
      font-size: 14px;
      border: none;
      border-radius: 12px;
      cursor: pointer;
      transition: all 0.3s ease;
      box-shadow: var(--glow-primary);
      position: relative;
      overflow: hidden;
    }
    
    .workspace-btn::before {
      content: '';
      position: absolute;
      top: 0;
      left: -100%;
      width: 100%;
      height: 100%;
      background: linear-gradient(90deg, transparent, rgba(255,255,255,0.3), transparent);
      transition: left 0.5s ease;
    }
    
    .workspace-btn:hover::before {
      left: 100%;
    }
    
    .workspace-btn:hover {
      transform: translateY(-2px);
      box-shadow: 0 0 40px rgba(0, 229, 255, 0.5);
    }
    
    .user-section {
      display: flex;
      align-items: center;
      gap: 14px;
    }
    
    .user-profile {
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 8px 16px 8px 8px;
      background: var(--bg-glass-light);
      border: 1px solid var(--border-subtle);
      border-radius: 50px;
      cursor: pointer;
      transition: all 0.3s ease;
    }
    
    .user-profile:hover {
      border-color: var(--accent-primary);
      box-shadow: 0 0 20px rgba(0, 229, 255, 0.2);
    }
    
    .user-avatar {
      width: 36px;
      height: 36px;
      border-radius: 50%;
      background: linear-gradient(135deg, var(--accent-primary), var(--accent-pink));
      display: flex;
      align-items: center;
      justify-content: center;
      font-family: var(--font-heading);
      font-weight: 700;
      font-size: 14px;
      color: white;
      position: relative;
    }
    
    .user-avatar::after {
      content: '';
      position: absolute;
      bottom: 0;
      right: 0;
      width: 10px;
      height: 10px;
      background: var(--accent-green);
      border-radius: 50%;
      border: 2px solid var(--bg-primary);
    }
    
    .user-info {
      display: flex;
      flex-direction: column;
      gap: 2px;
    }
    
    .user-name {
      font-size: 13px;
      font-weight: 600;
      color: var(--text-primary);
    }
    
    .user-role {
      font-size: 11px;
      color: var(--accent-primary);
      font-family: var(--font-mono);
    }
    
    .theme-toggle {
      width: 44px;
      height: 44px;
      border-radius: 12px;
      background: var(--bg-glass-light);
      border: 1px solid var(--border-subtle);
      color: var(--text-secondary);
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: all 0.3s ease;
    }
    
    .theme-toggle:hover {
      color: var(--accent-primary);
      border-color: var(--accent-primary);
    }
    
    /* Page Navigation Bar */
    .page-nav-bar {
      position: fixed;
      top: calc(var(--nav-height) + 16px);
      left: 50%;
      transform: translateX(-50%);
      z-index: 90;
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 10px 20px;
      background: var(--bg-glass);
      backdrop-filter: blur(16px);
      border: 1px solid var(--border-subtle);
      border-radius: 50px;
    }
    
    .page-nav-btn {
      display: flex;
      align-items: center;
      gap: 8px;
      padding: 8px 16px;
      background: transparent;
      border: 1px solid var(--border-subtle);
      border-radius: 25px;
      color: var(--text-secondary);
      font-size: 13px;
      font-weight: 500;
      cursor: pointer;
      transition: all 0.3s ease;
      text-decoration: none;
    }
    
    .page-nav-btn:hover {
      background: var(--bg-glass-light);
      border-color: var(--accent-primary);
      color: var(--accent-primary);
    }
    
    .page-nav-btn .material-icons-round {
      font-size: 18px;
    }
    
    .page-indicator {
      font-size: 12px;
      color: var(--text-muted);
      font-family: var(--font-mono);
      padding: 0 8px;
    }
    
    /* Main Content */
    .main-content {
      position: relative;
      z-index: 10;
      margin-left: var(--sidebar-width);
      margin-right: var(--sidebar-width);
      padding-top: calc(var(--nav-height) + 24px);
      min-height: 100vh;
    }
    
    /* Platform Hero */
    .platform-hero {
      padding: 80px 60px;
      text-align: center;
      position: relative;
    }
    
    .hero-badge {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 8px 20px;
      background: rgba(0, 229, 255, 0.1);
      border: 1px solid rgba(0, 229, 255, 0.3);
      border-radius: 50px;
      font-size: 13px;
      font-weight: 500;
      color: var(--accent-primary);
      margin-bottom: 32px;
      font-family: var(--font-mono);
      letter-spacing: 0.5px;
    }
    
    .hero-badge .pulse-dot {
      width: 8px;
      height: 8px;
      background: var(--accent-primary);
      border-radius: 50%;
      animation: pulse 2s ease-in-out infinite;
    }
    
    @keyframes pulse {
      0%, 100% { opacity: 1; transform: scale(1); }
      50% { opacity: 0.5; transform: scale(1.5); }
    }
    
    .platform-title {
      font-family: var(--font-heading);
      font-size: clamp(42px, 6vw, 72px);
      font-weight: 900;
      line-height: 1.05;
      margin-bottom: 24px;
      letter-spacing: -2px;
    }
    
    .platform-title .gradient-text {
      background: linear-gradient(135deg, var(--accent-primary), var(--accent-tertiary), var(--accent-pink));
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }
    
    .platform-subtitle {
      font-size: clamp(17px, 2vw, 22px);
      color: var(--text-secondary);
      max-width: 750px;
      margin: 0 auto 48px;
      line-height: 1.6;
      font-weight: 300;
    }
    
    /* Platform Tabs */
    .platform-tabs {
      display: flex;
      justify-content: center;
      gap: 12px;
      margin-bottom: 64px;
      flex-wrap: wrap;
      padding: 0 20px;
    }
    
    .platform-tab {
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 14px 28px;
      background: var(--bg-glass);
      backdrop-filter: blur(10px);
      border: 1px solid var(--border-subtle);
      border-radius: 14px;
      color: var(--text-secondary);
      font-size: 15px;
      font-weight: 500;
      cursor: pointer;
      transition: all 0.3s ease;
    }
    
    .platform-tab:hover {
      border-color: var(--accent-primary);
      color: var(--text-primary);
      transform: translateY(-2px);
    }
    
    .platform-tab.active {
      background: linear-gradient(135deg, rgba(0, 229, 255, 0.15), rgba(167, 139, 250, 0.15));
      border-color: var(--accent-primary);
      color: var(--accent-primary);
    }
    
    .platform-tab .material-icons-round {
      font-size: 20px;
    }
    
    /* Platform Sections */
    .platform-section {
      padding: 60px;
      display: none;
      animation: fadeInUp 0.5s ease;
    }
    
    .platform-section.active {
      display: block;
    }
    
    @keyframes fadeInUp {
      from { opacity: 0; transform: translateY(20px); }
      to { opacity: 1; transform: translateY(0); }
    }
    
    .section-header {
      margin-bottom: 48px;
    }
    
    .section-tag {
      font-family: var(--font-mono);
      font-size: 13px;
      color: var(--accent-primary);
      text-transform: uppercase;
      letter-spacing: 2px;
      margin-bottom: 16px;
    }
    
    .section-title {
      font-family: var(--font-heading);
      font-size: clamp(28px, 4vw, 44px);
      font-weight: 800;
      margin-bottom: 16px;
      letter-spacing: -1px;
    }
    
    .section-desc {
      font-size: 17px;
      color: var(--text-secondary);
      max-width: 650px;
      line-height: 1.7;
    }
    
    /* Feature Cards Grid */
    .feature-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(340px, 1fr));
      gap: 24px;
      margin-top: 40px;
    }
    
    .feature-card {
      background: var(--bg-glass);
      backdrop-filter: blur(20px);
      border: 1px solid var(--border-subtle);
      border-radius: 24px;
      padding: 32px;
      transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
      position: relative;
      overflow: hidden;
    }
    
    .feature-card::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      height: 3px;
      background: linear-gradient(90deg, var(--accent-primary), var(--accent-tertiary));
      opacity: 0;
      transition: opacity 0.3s ease;
    }
    
    .feature-card:hover {
      transform: translateY(-8px);
      border-color: var(--accent-primary);
      box-shadow: 0 20px 60px rgba(0, 229, 255, 0.15);
    }
    
    .feature-card:hover::before {
      opacity: 1;
    }
    
    .feature-icon {
      width: 56px;
      height: 56px;
      border-radius: 16px;
      background: linear-gradient(135deg, rgba(0, 229, 255, 0.15), rgba(167, 139, 250, 0.15));
      display: flex;
      align-items: center;
      justify-content: center;
      margin-bottom: 24px;
    }
    
    .feature-icon .material-icons-round {
      font-size: 28px;
      color: var(--accent-primary);
    }
    
    .feature-title {
      font-size: 20px;
      font-weight: 700;
      margin-bottom: 12px;
    }
    
    .feature-desc {
      font-size: 15px;
      color: var(--text-secondary);
      line-height: 1.7;
    }
    
    /* Interactive Demo Areas */
    .demo-area {
      background: var(--bg-glass);
      backdrop-filter: blur(20px);
      border: 1px solid var(--border-subtle);
      border-radius: 24px;
      padding: 32px;
      margin-top: 40px;
    }
    
    .demo-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 24px;
      padding-bottom: 20px;
      border-bottom: 1px solid var(--border-subtle);
    }
    
    .demo-title {
      font-size: 18px;
      font-weight: 600;
      display: flex;
      align-items: center;
      gap: 10px;
    }
    
    .demo-status {
      display: flex;
      align-items: center;
      gap: 8px;
      font-size: 13px;
      color: var(--accent-green);
      font-family: var(--font-mono);
    }
    
    .status-dot {
      width: 8px;
      height: 8px;
      background: var(--accent-green);
      border-radius: 50%;
      animation: pulse 2s ease-in-out infinite;
    }
    
    /* API Provider Cards */
    .provider-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
      gap: 20px;
      margin-top: 24px;
    }
    
    .provider-card {
      background: var(--bg-glass-light);
      border: 1px solid var(--border-subtle);
      border-radius: 16px;
      padding: 24px;
      transition: all 0.3s ease;
    }
    
    .provider-card:hover {
      border-color: var(--accent-primary);
      background: rgba(0, 229, 255, 0.03);
    }
    
    .provider-header {
      display: flex;
      align-items: center;
      gap: 14px;
      margin-bottom: 16px;
    }
    
    .provider-logo {
      width: 44px;
      height: 44px;
      border-radius: 12px;
      background: linear-gradient(135deg, var(--accent-primary), var(--accent-tertiary));
      display: flex;
      align-items: center;
      justify-content: center;
      font-weight: 700;
      font-size: 16px;
      color: white;
    }
    
    .provider-name {
      font-weight: 600;
      font-size: 16px;
    }
    
    .provider-status {
      font-size: 12px;
      color: var(--text-muted);
    }
    
    .provider-actions {
      display: flex;
      gap: 10px;
      margin-top: 16px;
    }
    
    .btn-sm {
      flex: 1;
      padding: 10px 16px;
      font-size: 13px;
      font-weight: 500;
      border-radius: 10px;
      cursor: pointer;
      transition: all 0.2s ease;
      border: 1px solid var(--border-subtle);
      background: var(--bg-glass-light);
      color: var(--text-secondary);
    }
    
    .btn-sm:hover {
      border-color: var(--accent-primary);
      color: var(--accent-primary);
    }
    
    .btn-sm.primary {
      background: linear-gradient(135deg, var(--accent-primary), var(--accent-secondary));
      color: var(--bg-deep);
      border: none;
    }
    
    /* Workspace Demo */
    .workspace-demo {
      display: grid;
      grid-template-columns: 240px 1fr 280px;
      gap: 20px;
      min-height: 500px;
    }
    
    .workspace-sidebar {
      background: var(--bg-glass-light);
      border: 1px solid var(--border-subtle);
      border-radius: 16px;
      padding: 20px;
    }
    
    .workspace-user-list {
      display: flex;
      flex-direction: column;
      gap: 12px;
    }
    
    .workspace-user {
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 10px;
      border-radius: 10px;
      cursor: pointer;
      transition: all 0.2s ease;
    }
    
    .workspace-user:hover {
      background: var(--bg-glass);
    }
    
    .workspace-user.active {
      background: rgba(0, 229, 255, 0.1);
    }
    
    .user-mini-avatar {
      width: 36px;
      height: 36px;
      border-radius: 50%;
      background: linear-gradient(135deg, var(--accent-primary), var(--accent-pink));
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 13px;
      font-weight: 600;
      color: white;
    }
    
    .user-mini-info {
      flex: 1;
    }
    
    .user-mini-name {
      font-size: 13px;
      font-weight: 500;
    }
    
    .user-mini-status {
      font-size: 11px;
      color: var(--accent-green);
    }
    
    .workspace-editor {
      background: var(--bg-glass-light);
      border: 1px solid var(--border-subtle);
      border-radius: 16px;
      padding: 24px;
      font-family: var(--font-mono);
      font-size: 14px;
      line-height: 1.8;
      color: var(--text-secondary);
    }
    
    .workspace-chat {
      background: var(--bg-glass-light);
      border: 1px solid var(--border-subtle);
      border-radius: 16px;
      padding: 20px;
    }
    
    .chat-message {
      padding: 12px;
      margin-bottom: 12px;
      border-radius: 12px;
      background: var(--bg-glass);
      font-size: 13px;
    }
    
    .chat-message .sender {
      font-weight: 600;
      font-size: 12px;
      color: var(--accent-primary);
      margin-bottom: 6px;
    }
    
    /* Pipeline Visual */
    .pipeline-stages {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
      margin-top: 32px;
      flex-wrap: wrap;
    }
    
    .pipeline-stage {
      flex: 1;
      min-width: 150px;
      text-align: center;
      padding: 24px 16px;
      background: var(--bg-glass);
      border: 1px solid var(--border-subtle);
      border-radius: 16px;
      transition: all 0.3s ease;
    }
    
    .pipeline-stage:hover {
      border-color: var(--accent-primary);
      transform: translateY(-4px);
    }
    
    .stage-icon {
      width: 52px;
      height: 52px;
      margin: 0 auto 16px;
      border-radius: 14px;
      background: linear-gradient(135deg, var(--accent-primary), var(--accent-tertiary));
      display: flex;
      align-items: center;
      justify-content: center;
    }
    
    .stage-icon .material-icons-round {
      font-size: 26px;
      color: white;
    }
    
    .stage-name {
      font-weight: 600;
      font-size: 14px;
      margin-bottom: 6px;
    }
    
    .stage-desc {
      font-size: 12px;
      color: var(--text-muted);
    }
    
    .pipeline-arrow-mobile {
      color: var(--accent-primary);
      font-size: 24px;
    }
    
    /* Footer */
    .footer {
      padding: 60px;
      border-top: 1px solid var(--border-subtle);
      background: var(--bg-glass);
    }
    
    .footer-content {
      display: grid;
      grid-template-columns: 2fr repeat(3, 1fr);
      gap: 48px;
      max-width: 1200px;
      margin: 0 auto;
    }
    
    .footer-brand {
      display: flex;
      flex-direction: column;
      gap: 20px;
    }
    
    .footer-logo {
      display: flex;
      align-items: center;
      gap: 12px;
    }
    
    .footer-logo-icon {
      width: 40px;
      height: 40px;
      background: linear-gradient(135deg, var(--accent-primary), var(--accent-tertiary));
      border-radius: 10px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-family: var(--font-tech);
      font-weight: 900;
      font-size: 14px;
      color: var(--bg-deep);
    }
    
    .footer-logo-text {
      font-family: var(--font-heading);
      font-size: 20px;
      font-weight: 700;
    }
    
    .footer-desc {
      font-size: 14px;
      color: var(--text-muted);
      line-height: 1.7;
    }
    
    .footer-column h4 {
      font-size: 14px;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 1px;
      margin-bottom: 20px;
      color: var(--text-primary);
    }
    
    .footer-links {
      display: flex;
      flex-direction: column;
      gap: 12px;
    }
    
    .footer-links a {
      color: var(--text-muted);
      text-decoration: none;
      font-size: 14px;
      transition: color 0.2s ease;
    }
    
    .footer-links a:hover {
      color: var(--accent-primary);
    }
    
    .footer-links::-webkit-scrollbar {
      height: 6px;
    }
    
    .footer-links::-webkit-scrollbar-thumb {
      background: var(--accent);
      border-radius: 3px;
    }
    
    .footer-bottom {
      margin-top: 48px;
      padding-top: 24px;
      border-top: 1px solid var(--border-subtle);
      display: flex;
      justify-content: space-between;
      align-items: center;
      font-size: 13px;
      color: var(--text-muted);
    }
    
    .footer-social {
      display: flex;
      gap: 16px;
    }
    
    .footer-social a {
      color: var(--text-muted);
      transition: color 0.2s ease;
    }
    
    .footer-social a:hover {
      color: var(--accent-primary);
    }
    
    /* Responsive */
    @media (max-width: 1024px) {
      :root {
        --sidebar-width: 60px;
      }
      
      .molecular-sidebar {
        width: 60px;
      }
      
      .dna-helix {
        width: 40px;
      }
      
      .nucleotide {
        width: 8px;
        height: 8px;
      }
      
      .nav-container {
        padding: 0 20px;
      }
      
      .nav-links {
        display: none;
      }
      
      .main-content {
        padding-left: 20px;
        padding-right: 20px;
      }
      
      .platform-hero,
      .platform-section {
        padding-left: 30px;
        padding-right: 30px;
      }
      
      .workspace-demo {
        grid-template-columns: 1fr;
      }
      
      .footer-content {
        grid-template-columns: 1fr 1fr;
      }
    }
    
    @media (max-width: 768px) {
      :root {
        --sidebar-width: 0px;
        --nav-height: 70px;
      }
      
      .molecular-sidebar {
        display: none;
      }
      
      .neural-bg {
        width: 100%;
        left: 0;
      }
      
      .main-content {
        margin-left: 0;
        margin-right: 0;
      }
      
      .nav-container {
        left: 0;
        right: 0;
        padding: 0 16px;
      }
      
      .page-nav-bar {
        display: none;
      }
      
      .platform-title {
        font-size: 32px;
      }
      
      .feature-grid {
        grid-template-columns: 1fr;
      }
      
      .pipeline-stages {
        flex-direction: column;
      }
      
      .pipeline-arrow-mobile {
        transform: rotate(90deg);
      }
      
      .footer-content {
        grid-template-columns: 1fr;
        gap: 32px;
      }
      
      .footer-bottom {
        flex-direction: column;
        gap: 16px;
        text-align: center;
      }
    }
  </style>
</head>
<body>
  <!-- Left Molecular Sidebar -->
  <aside class="molecular-sidebar left">
    <div class="molecular-grid"></div>
    <div class="dna-helix">
      <div class="backbone-line"></div>
      <div class="dna-strand" id="leftDnaStrand"></div>
    </div>
    <div class="protein-chain" id="leftProteinChain"></div>
    <div class="floating-molecule" style="width: 20px; height: 20px; top: 15%; left: 30%;"></div>
    <div class="floating-molecule" style="width: 14px; height: 14px; top: 45%; left: 55%;"></div>
    <div class="floating-molecule" style="width: 18px; height: 18px; top: 75%; left: 25%;"></div>
  </aside>

  <!-- Right Molecular Sidebar -->
  <aside class="molecular-sidebar right">
    <div class="molecular-grid"></div>
    <div class="dna-helix">
      <div class="backbone-line"></div>
      <div class="dna-strand" id="rightDnaStrand"></div>
    </div>
    <div class="protein-chain" id="rightProteinChain"></div>
    <div class="floating-molecule" style="width: 16px; height: 16px; top: 25%; left: 40%;"></div>
    <div class="floating-molecule" style="width: 22px; height: 22px; top: 55%; left: 60%;"></div>
    <div class="floating-molecule" style="width: 12px; height: 12px; top: 85%; left: 35%;"></div>
  </aside>

  <!-- Neural Background -->
  <div class="neural-bg" id="neuralBg"></div>

  <!-- Navigation -->
  <nav class="nav-container">
    <a href="index.html" class="nav-brand">
      <div class="nav-logo">S</div>
      <span class="nav-title">Sci<span>MSPT</span></span>
    </a>
    
    <div class="nav-links">
      <a href="index.html" class="nav-link">
        <span class="material-icons-round">home</span>
        Home
      </a>
      <a href="research.html" class="nav-link">
        <span class="material-icons-round">biotech</span>
        Research
      </a>
      <a href="startups.html" class="nav-link">
        <span class="material-icons-round">rocket_launch</span>
        Startups
      </a>
      <a href="platform.html" class="nav-link active">
        <span class="material-icons-round">dashboard</span>
        Platform
      </a>
      <a href="documentation.html" class="nav-link">
        <span class="material-icons-round">code</span>
        API Docs
      </a>
      <a href="about.html" class="nav-link">
        <span class="material-icons-round">info</span>
        About
      </a>
    </div>
    
    <div style="display: flex; align-items: center; gap: 16px;">
      <button class="theme-toggle" onclick="toggleTheme()" title="Toggle theme">
        <span class="material-icons-round" id="themeIcon">dark_mode</span>
      </button>
      
      <button class="workspace-btn" onclick="openWorkspace()">
        <span class="material-icons-round">workspaces</span>
        Workspace
      </button>
      
      <div class="user-profile" onclick="toggleUserMenu()">
        <div class="user-avatar">EV</div>
        <div class="user-info">
          <span class="user-name">Dr. Elena Vasquez</span>
          <span class="user-role">Neural Architect</span>
        </div>
      </div>
    </div>
  </nav>

  <!-- Page Navigation Bar -->
  <div class="page-nav-bar">
    <a href="javascript:history.back()" class="page-nav-btn">
      <span class="material-icons-round">arrow_back</span>
      Back
    </a>
    <span class="page-indicator">|</span>
    <a href="index.html" class="page-nav-btn">
      <span class="material-icons-round">home</span>
      Home
    </a>
    <span class="page-indicator">|</span>
    <a href="#collaboration" class="page-nav-btn">
      <span class="material-icons-round">groups</span>
      Collaborate
    </a>
  </div>

  <!-- Main Content -->
  <main class="main-content">
    <!-- Platform Hero -->
    <section class="platform-hero">
      <div class="hero-badge">
        <span class="pulse-dot"></span>
        Neural Command Center — All Systems Operational
      </div>
      
      <h1 class="platform-title">
        Advanced <span class="gradient-text">Platform</span> Capabilities
      </h1>
      
      <p class="platform-subtitle">
        Explore our suite of integrated tools designed for the next generation 
        of scientific research analysis and collaborative discovery.
      </p>
      
      <div class="platform-tabs">
        <button class="platform-tab active" onclick="showSection('ai-api')">
          <span class="material-icons-round">api</span>
          AI API Integration
        </button>
        <button class="platform-tab" onclick="showSection('cloud-storage')">
          <span class="material-icons-round">cloud_sync</span>
          Cloud Storage
        </button>
        <button class="platform-tab" onclick="showSection('collaboration')">
          <span class="material-icons-round">groups</span>
          Collaboration
        </button>
        <button class="platform-tab" onclick="showSection('pipelines')">
          <span class="material-icons-round">account_tree</span>
          Analysis Pipelines
        </button>
        <button class="platform-tab" onclick="showSection('fine-tuning')">
          <span class="material-icons-round">tune</span>
          Model Fine-Tuning
        </button>
      </div>
    </section>

    <!-- AI API Integration Section -->
    <section class="platform-section active" id="ai-api">
      <div class="section-header">
        <p class="section-tag">// AI Integration Hub</p>
        <h2 class="section-title">Multi-Provider AI API Gateway</h2>
        <p class="section-desc">
          Connect to leading AI providers through our unified interface. 
          Manage keys, monitor usage, and switch providers seamlessly.
        </p>
      </div>
      
      <div class="feature-grid">
        <article class="feature-card">
          <div class="feature-icon">
            <span class="material-icons-round">security</span>
          </div>
          <h3 class="feature-title">Secure Key Management</h3>
          <p class="feature-desc">
            Enterprise-grade encryption for all API credentials with role-based 
            access control and audit logging for compliance requirements.
          </p>
        </article>
        
        <article class="feature-card">
          <div class="feature-icon">
            <span class="material-icons-round">speed</span>
          </div>
          <h3 class="feature-title">Intelligent Routing</h3>
          <p class="feature-desc">
            Automatic load balancing and failover across providers based on 
            latency, cost, and availability metrics in real-time.
          </p>
        </article>
        
        <article class="feature-card">
          <div class="feature-icon">
            <span class="material-icons-round">analytics</span>
          </div>
          <h3 class="feature-title">Usage Analytics</h3>
          <p class="feature-desc">
            Comprehensive dashboards showing token consumption, cost tracking, 
            and performance benchmarks across all connected services.
          </p>
        </article>
      </div>
      
      <div class="demo-area">
        <div class="demo-header">
          <div class="demo-title">
            <span class="material-icons-round">hub</span>
            Connected Providers
          </div>
          <div class="demo-status">
            <span class="status-dot"></span>
            6 Active Connections
          </div>
        </div>
        
        <div class="provider-grid">
          <div class="provider-card">
            <div class="provider-header">
              <div class="provider-logo">O</div>
              <div>
                <div class="provider-name">OpenAI</div>
                <div class="provider-status">GPT-4 Turbo • Connected</div>
              </div>
            </div>
            <div class="provider-actions">
              <button class="btn-sm primary">Test Connection</button>
              <button class="btn-sm">View Logs</button>
            </div>
          </div>
          
          <div class="provider-card">
            <div class="provider-header">
              <div class="provider-logo" style="background: linear-gradient(135deg, #d4a574, #c77d4e);">A</div>
              <div>
                <div class="provider-name">Anthropic</div>
                <div class="provider-status">Claude 3 Opus • Connected</div>
              </div>
            </div>
            <div class="provider-actions">
              <button class="btn-sm primary">Test Connection</button>
              <button class="btn-sm">View Logs</button>
            </div>
          </div>
          
          <div class="provider-card">
            <div class="provider-header">
              <div class="provider-logo" style="background: linear-gradient(135deg, #4285f4, #34a853);">G</div>
              <div>
                <div class="provider-name">Google AI</div>
                <div class="provider-status">Gemini Pro • Connected</div>
              </div>
            </div>
            <div class="provider-actions">
              <button class="btn-sm primary">Test Connection</button>
              <button class="btn-sm">View Logs</button>
            </div>
          </div>
          
          <div class="provider-card">
            <div class="provider-header">
              <div class="provider-logo" style="background: linear-gradient(135deg, #ff6b35, #f7931e);">M</div>
              <div>
                <div class="provider-name">Mistral AI</div>
                <div class="provider-status">Mistral Large • Connected</div>
              </div>
            </div>
            <div class="provider-actions">
              <button class="btn-sm primary">Test Connection</button>
              <button class="btn-sm">View Logs</button>
            </div>
          </div>
          
          <div class="provider-card">
            <div class="provider-header">
              <div class="provider-logo" style="background: linear-gradient(135deg, #a855f7, #6366f1);">Gr</div>
              <div>
                <div class="provider-name">Groq</div>
                <div class="provider-status">Mixtral 8x • Connected</div>
              </div>
            </div>
            <div class="provider-actions">
              <button class="btn-sm primary">Test Connection</button>
              <button class="btn-sm">View Logs</button>
            </div>
          </div>
          
          <div class="provider-card">
            <div class="provider-header">
              <div class="provider-logo" style="background: linear-gradient(135deg, #06b6d4, #0891b2);">C</div>
              <div>
                <div class="provider-name">Cohere</div>
                <div class="provider-status">Command R+ • Connected</div>
              </div>
            </div>
            <div class="provider-actions">
              <button class="btn-sm primary">Test Connection</button>
              <button class="btn-sm">View Logs</button>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Cloud Storage Section -->
    <section class="platform-section" id="cloud-storage">
      <div class="section-header">
        <p class="section-tag">// Data Persistence Layer</p>
        <h2 class="section-title">Cloud Storage Synchronization</h2>
        <p class="section-desc">
          Seamless file management with automatic backup, version control, 
          and cross-device synchronization powered by distributed storage.
        </p>
      </div>
      
      <div class="feature-grid">
        <article class="feature-card">
          <div class="feature-icon">
            <span class="material-icons-round">folder_special</span>
          </div>
          <h3 class="feature-title">Smart File Organization</h3>
          <p class="feature-desc">
            AI-powered categorization that automatically organizes your research 
            files by topic, date, project, and relevance using semantic understanding.
          </p>
        </article>
        
        <article class="feature-card">
          <div class="feature-icon">
            <span class="material-icons-round">history</span>
          </div>
          <h3 class="feature-title">Version Timeline</h3>
          <p class="feature-desc">
            Complete version history with diff visualization, rollback capability, 
            and branching support for experimental workflows.
          </p>
        </article>
        
        <article class="feature-card">
          <div class="feature-icon">
            <span class="material-icons-round">sync</span>
          </div>
          <h3 class="feature-title">Real-time Sync</h3>
          <p class="feature-desc">
            Instant synchronization across all devices with conflict resolution 
            algorithms optimized for collaborative editing scenarios.
          </p>
        </article>
      </div>
      
      <div class="demo-area">
        <div class="demo-header">
          <div class="demo-title">
            <span class="material-icons-round">storage</span>
            Storage Dashboard
          </div>
          <div class="demo-status">
            <span class="status-dot"></span>
            Synced 2 min ago
          </div>
        </div>
        <div style="padding: 20px; text-align: center; color: var(--text-muted);">
          <span class="material-icons-round" style="font-size: 48px; opacity: 0.3;">cloud_done</span>
          <p style="margin-top: 16px;">Storage interface ready — Connect to enable full functionality</p>
        </div>
      </div>
    </section>

    <!-- Collaboration Section -->
    <section class="platform-section" id="collaboration">
      <div class="section-header">
        <p class="section-tag">// Team Intelligence</p>
        <h2 class="section-title">Collaborative Workspaces</h2>
        <p class="section-desc">
          Real-time collaboration environments where teams can analyze research, 
          share insights, and build collective intelligence together.
        </p>
      </div>
      
      <div class="feature-grid">
        <article class="feature-card">
          <div class="feature-icon">
            <span class="material-icons-round">edit_note</span>
          </div>
          <h3 class="feature-title">Live Document Editing</h3>
          <p class="feature-desc">
            Multi-cursor editing with presence indicators, change tracking, 
            and intelligent merge algorithms for simultaneous contributions.
          </p>
        </article>
        
        <article class="feature-card">
          <div class="feature-icon">
            <span class="material-icons-round">forum</span>
          </div>
          <h3 class="feature-title">Integrated Communication</h3>
          <p class="feature-desc">
            Context-aware chat threaded within documents, video conferencing, 
            and annotation systems for seamless team coordination.
          </p>
        </article>
        
        <article class="feature-card">
          <div class="feature-icon">
            <span class="material-icons-round">share</span>
          </div>
          <h3 class="feature-title">Permission Control</h3>
          <p class="feature-desc">
            Granular access controls with view/edit/admin roles, external sharing 
            with expiration, and audit trails for compliance.
          </p>
        </article>
      </div>
      
      <div class="demo-area">
        <div class="demo-header">
          <div class="demo-title">
            <span class="material-icons-round">groups_3</span>
            Active Workspace Preview
          </div>
          <div class="demo-status">
            <span class="status-dot"></span>
            4 Members Online
          </div>
        </div>
        
        <div class="workspace-demo">
          <div class="workspace-sidebar">
            <h4 style="font-size: 14px; margin-bottom: 16px; color: var(--text-muted);">TEAM MEMBERS</h4>
            <div class="workspace-user-list">
              <div class="workspace-user active">
