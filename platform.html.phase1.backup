  <script>
    // Synthetic user data
    const userData = {
      current: {
        name: 'Dr. Elena Vasquez',
        initials: 'EV',
        email: 'elena.vasquez@scimspt.io',
        role: 'Neural Architect'
      }
    };
    
    // Initialize DNA Helix
    function initDnaHelix() {
      const strands = [
        { container: 'leftDnaStrand', offset: 0 },
        { container: 'rightDnaStrand', offset: 50 }
      ];
      
      const nucleotides = ['adenine', 'thymine', 'guanine', 'cytosine'];
      
      strands.forEach(({ container, offset }) => {
        const strand = document.getElementById(container);
        if (!strand) return;
        
        for (let i = 0; i < 20; i++) {
          const nucleotide = document.createElement('div');
          nucleotide.className = `nucleotide ${nucleotides[i % 4]}`;
          
          const y = (i / 20) * 100;
          const x = 50 + Math.sin((i + offset) * 0.5) * 35;
          const delay = (i * 0.15) % 3;
          
          nucleotide.style.cssText = `
            top: ${y}%;
            left: ${x}%;
            transform: translate(-50%, -50%);
            animation-delay: ${delay}s;
          `;
          
          strand.appendChild(nucleotide);
        }
      });
    }
    
    // Initialize Protein Chains
    function initProteinChains() {
      const chains = ['leftProteinChain', 'rightProteinChain'];
      
      chains.forEach(chainId => {
        const chain = document.getElementById(chainId);
        if (!chain) return;
        
        for (let i = 0; i < 12; i++) {
          const amino = document.createElement('div');
          amino.className = 'amino-acid';
          
          const y = (i / 12) * 100;
          const x = Math.sin(i * 0.8) * 15;
          const delay = (i * 0.3) % 4;
          const hue = (i * 30) % 360;
          
          amino.style.cssText = `
            top: ${y}%;
            left: calc(50% + ${x}px);
            transform: translate(-50%, -50%);
            animation-delay: ${delay}s;
            background: hsl(${hue}, 70%, 60%);
          `;
          
          chain.appendChild(amino);
        }
      });
    }
    
    // Initialize Neural Background
    function initNeuralBackground() {
      const bg = document.getElementById('neuralBg');
      if (!bg) return;
      
      for (let i = 0; i < 50; i++) {
        const neuron = document.createElement('div');
        neuron.className = 'neuron';
        neuron.style.cssText = `
          left: ${Math.random() * 100}%;
          top: ${Math.random() * 100}%;
          animation-delay: ${Math.random() * 4}s;
        `;
        bg.appendChild(neuron);
      }
      
      for (let i = 0; i < 30; i++) {
        const synapse = document.createElement('div');
        synapse.className = 'synapse';
        synapse.style.cssText = `
          left: ${Math.random() * 100}%;
          top: ${Math.random() * 100}%;
          width: ${50 + Math.random() * 150}px;
          animation-delay: ${Math.random() * 3}s;
        `;
        bg.appendChild(synapse);
      }
    }
    
    // Theme Toggle
    function toggleTheme() {
      const html = document.documentElement;
      const icon = document.getElementById('themeIcon');
      const isDark = html.getAttribute('data-theme') === 'dark';
      
      html.setAttribute('data-theme', isDark ? 'light' : 'dark');
      icon.textContent = isDark ? 'light_mode' : 'dark_mode';
      localStorage.setItem('theme', isDark ? 'light' : 'dark');
    }
    
    // Load saved theme
    function loadTheme() {
      const saved = localStorage.getItem('theme');
      if (saved) {
        document.documentElement.setAttribute('data-theme', saved);
        document.getElementById('themeIcon').textContent = 
          saved === 'dark' ? 'dark_mode' : 'light_mode';
      }
    }
    
    // Show Platform Section
    function showSection(sectionId) {
      // Update tabs
      document.querySelectorAll('.platform-tab').forEach(tab => {
        tab.classList.remove('active');
      });
      event.target.closest('.platform-tab').classList.add('active');
      
      // Update sections
      document.querySelectorAll('.platform-section').forEach(section => {
        section.classList.remove('active');
      });
      document.getElementById(sectionId).classList.add('active');
      
      // Update URL hash
      history.pushState(null, null, `#${sectionId}`);
    }
    
    // Open Workspace
    function openWorkspace() {
      showSection('collaboration');
      document.querySelector('[onclick*="collaboration"]').click();
    }
    
    // Toggle User Menu
    function toggleUserMenu() {
      // Simple toggle - could expand to dropdown
      showNotification('Profile menu coming soon!');
    }
    
    // Notification System
    function showNotification(message) {
      const notification = document.createElement('div');
      notification.style.cssText = `
        position: fixed;
        bottom: 30px;
        right: 30px;
        padding: 20px 28px;
        background: linear-gradient(135deg, var(--accent-primary), var(--accent-tertiary));
        color: var(--bg-deep);
        border-radius: 14px;
        font-weight: 600;
        z-index: 9999;
        animation: slideIn 0.4s ease;
        box-shadow: 0 10px 40px rgba(0, 229, 255, 0.3);
      `;
      notification.textContent = message;
      document.body.appendChild(notification);
      
      setTimeout(() => {
        notification.style.animation = 'slideOut 0.3s ease forwards';
        setTimeout(() => notification.remove(), 300);
      }, 4000);
    }
    
    // Add CSS animations
    const style = document.createElement('style');
    style.textContent = `
      @keyframes slideIn {
        from { transform: translateX(100px); opacity: 0; }
        to { transform: translateX(0); opacity: 1; }
      }
      @keyframes slideOut {
        from { transform: translateX(0); opacity: 1; }
        to { transform: translateX(100px); opacity: 0; }
      }
    `;
    document.head.appendChild(style);
    
    // Handle hash navigation
    window.addEventListener('hashchange', () => {
      const hash = window.location.hash.replace('#', '');
      if (hash && document.getElementById(hash)) {
        showSection(hash);
      }
    });
    
    // Initialize
    document.addEventListener('DOMContentLoaded', () => {
      loadTheme();
      initDnaHelix();
      initProteinChains();
      initNeuralBackground();
      
      // Check URL hash
      const hash = window.location.hash.replace('#', '');
      if (hash) {
        const tab = document.querySelector(`[onclick*="${hash}"]`);
        if (tab) tab.click();
      }
    });
  </script>
</body>
</html>