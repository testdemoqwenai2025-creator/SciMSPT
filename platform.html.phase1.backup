    <!-- Analysis Pipelines Section -->
    <section class="platform-section" id="pipelines">
      <div class="section-header">
        <p class="section-tag">// Automated Processing</p>
        <h2 class="section-title">Analysis Pipeline Builder</h2>
        <p class="section-desc">
          Visual pipeline construction for transforming raw research data into 
          actionable insights through configurable processing stages.
        </p>
      </div>
      
      <div class="feature-grid">
        <article class="feature-card">
          <div class="feature-icon">
            <span class="material-icons-round">account_tree</span>
